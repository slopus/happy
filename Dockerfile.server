# Production image: the Rust server (packages/happy-server-rs), wire-compatible
# with packages/happy-server. The schema is still the TS server's Prisma schema,
# and the image keeps the Prisma CLI so `prisma migrate deploy` runs exactly as
# before (CI and the deploy Job run it from /repo/packages/happy-server).
#
# The Rust server is a single process per database (no Redis adapter; it takes a
# Postgres advisory lock and refuses to start beside another instance), so it
# must run as one replica, and a deploy must stop the old pod before starting
# the new one. See packages/happy-server-rs/COMPAT.md and QUIRKS.md.

# Stage 1: the Prisma CLI and the schema, for migrations
FROM node:24-bookworm AS deps

RUN corepack enable && corepack prepare pnpm@10.11.0 --activate

WORKDIR /repo

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY scripts ./scripts
COPY patches ./patches

RUN mkdir -p packages/happy-server packages/happy-cli packages/happy-wire

COPY packages/happy-server/package.json packages/happy-server/
COPY packages/happy-cli/package.json packages/happy-cli/
COPY packages/happy-wire/package.json packages/happy-wire/

# Workspace postinstall requirements
COPY packages/happy-server/prisma packages/happy-server/prisma
COPY packages/happy-cli/scripts packages/happy-cli/scripts
COPY packages/happy-cli/tools packages/happy-cli/tools

RUN SKIP_HAPPY_WIRE_BUILD=1 pnpm install --frozen-lockfile --filter happy-server...

# Stage 2: build the Rust server
FROM rust:1.99-bookworm AS builder

WORKDIR /repo

# build.rs embeds the Prisma migrations (for `happy-server-rs migrate`).
COPY packages/happy-server/prisma packages/happy-server/prisma
COPY packages/happy-server-rs packages/happy-server-rs

RUN cargo build --release --locked --manifest-path packages/happy-server-rs/Cargo.toml --bin happy-server-rs

# Stage 3: runtime
FROM node:24-bookworm-slim AS runner

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl && rm -rf /var/lib/apt/lists/*
# pnpm as before, for migration commands run through it
RUN corepack enable && corepack prepare pnpm@10.11.0 --activate

WORKDIR /repo

# Production log level (errors plus the 30 s http:summary line).
ENV NODE_ENV=production

# Prisma CLI and schema, for `prisma migrate deploy`
COPY --from=deps /repo/node_modules /repo/node_modules
COPY --from=deps /repo/packages/happy-server /repo/packages/happy-server
COPY --from=deps /repo/package.json /repo/pnpm-workspace.yaml /repo/

COPY --from=builder /repo/packages/happy-server-rs/target/release/happy-server-rs /usr/local/bin/happy-server-rs

# Expose the port the app will run on
EXPOSE 3000

WORKDIR /repo/packages/happy-server
CMD ["happy-server-rs", "serve"]
