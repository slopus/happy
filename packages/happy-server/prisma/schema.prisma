// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider        = "prisma-client-js"
    previewFeatures = ["metrics", "relationJoins", "driverAdapters"]
}

generator json {
    provider = "prisma-json-types-generator"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

//
// Account
//

model Account {
    id              String      @id @default(cuid())
    publicKey       String      @unique
    seq             Int         @default(0)
    feedSeq         BigInt      @default(0)
    createdAt       DateTime    @default(now())
    updatedAt       DateTime    @updatedAt
    settings        String?
    settingsVersion Int         @default(0)
    githubUserId    String?     @unique
    githubUser      GithubUser? @relation(fields: [githubUserId], references: [id])

    // Profile
    firstName String?
    lastName  String?
    username  String? @unique
    /// [ImageRef]
    avatar    Json?

    Session             Session[]
    AccountPushToken    AccountPushToken[]
    TerminalAuthRequest TerminalAuthRequest[]
    AccountAuthRequest  AccountAuthRequest[]
    UsageReport         UsageReport[]
    ProviderUsageEvent  ProviderUsageEvent[]
    Machine             Machine[]
    UploadedFile        UploadedFile[]
    ServiceAccountToken ServiceAccountToken[]
    RelationshipsFrom   UserRelationship[]    @relation("RelationshipsFrom")
    RelationshipsTo     UserRelationship[]    @relation("RelationshipsTo")
    Artifact            Artifact[]
    AccessKey           AccessKey[]
    UserFeedItem        UserFeedItem[]
    UserKVStore         UserKVStore[]
    Project             Project[]
    ProjectMember       ProjectMember[]
    ProjectMemberInviter ProjectMember[]  @relation("ProjectMemberInviter")
    Workspace           Workspace[]
    MergeRequest        MergeRequest[]
    MergeRequestComment MergeRequestComment[]
    VoiceConversation   VoiceConversation[]
    AutomationOwner     Automation[]         @relation("AutomationOwner")
    SessionFollowupOwner SessionFollowup[]    @relation("SessionFollowupOwner")
    AgentLaunchProfile  AgentLaunchProfile[]
}

model AgentLaunchProfile {
    id              String   @id @default(cuid())
    accountId       String
    account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    name            String
    agent           String
    model           String?
    worktreeEnabled Boolean  @default(false)
    active          Boolean  @default(false)
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    @@unique([accountId, name])
    @@index([accountId, active])
}

model TerminalAuthRequest {
    id                String   @id @default(cuid())
    publicKey         String   @unique
    supportsV2        Boolean  @default(false)
    response          String?
    responseAccountId String?
    responseAccount   Account? @relation(fields: [responseAccountId], references: [id])
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt
}

model AccountAuthRequest {
    id                String   @id @default(cuid())
    publicKey         String   @unique
    response          String?
    responseAccountId String?
    responseAccount   Account? @relation(fields: [responseAccountId], references: [id])
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt
}

model AccountPushToken {
    id        String   @id @default(cuid())
    accountId String
    account   Account  @relation(fields: [accountId], references: [id])
    token     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([accountId, token])
}

//
// Sessions
//

model Session {
    id                String           @id @default(cuid())
    tag               String
    accountId         String
    account           Account          @relation(fields: [accountId], references: [id])
    metadata          String
    metadataVersion   Int              @default(0)
    agentState        String?
    agentStateVersion Int              @default(0)
    dataEncryptionKey Bytes?
    seq               Int              @default(0)
    eventSeq          Int              @default(0)
    active            Boolean          @default(true)
    lastActiveAt      DateTime         @default(now())
    createdAt         DateTime         @default(now())
    updatedAt         DateTime         @updatedAt
    messages          SessionMessage[]
    events            SessionEvent[]
    usageReports      UsageReport[]
    accessKeys        AccessKey[]

    @@unique([accountId, tag])
    @@index([accountId, updatedAt(sort: Desc)])
}

model SessionMessage {
    id        String   @id @default(cuid())
    sessionId String
    session   Session  @relation(fields: [sessionId], references: [id])
    localId   String?
    seq       Int
    /// [SessionMessageContent]
    content   Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([sessionId, localId])
    @@index([sessionId, seq])
}

model SessionEvent {
    id             String   @id @default(cuid())
    sessionId      String
    session        Session  @relation(fields: [sessionId], references: [id])
    eventType      String
    seq            Int
    /// [SessionEventContent]
    content        Json
    /// [CheckpointEventMetadata]
    checkpoint     Json?
    idempotencyKey String?
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    @@unique([sessionId, idempotencyKey])
    @@index([sessionId, seq])
    @@index([sessionId, eventType])
}

//
// Github
//

model GithubUser {
    id        String    @id
    /// [GitHubProfile]
    profile   Json
    token     Bytes?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    Account   Account[]
}

model GithubOrganization {
    id        String   @id
    /// [GitHubOrg]
    profile   Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

//
// Utility
//

model GlobalLock {
    key       String   @id @default(cuid())
    value     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    expiresAt DateTime
}

model RepeatKey {
    key       String   @id
    value     String
    createdAt DateTime @default(now())
    expiresAt DateTime
}

model SimpleCache {
    key       String   @id
    value     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

//
// Usage Reporting
//

model UsageReport {
    id        String   @id @default(cuid())
    key       String
    accountId String
    account   Account  @relation(fields: [accountId], references: [id])
    sessionId String?
    session   Session? @relation(fields: [sessionId], references: [id])
    /// [UsageReportData]
    data      Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([accountId, sessionId, key])
    @@index([accountId])
    @@index([sessionId])
}

model ProviderUsageEvent {
    id            String   @id @default(cuid())
    accountId     String
    account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    sessionId     String
    source        String
    sourceEventId String
    occurredAt    DateTime
    /// [AiUsageEventV1]
    data          Json
    createdAt     DateTime @default(now())
    outbox        UsageDeliveryOutbox?

    @@unique([source, sourceEventId])
    @@index([accountId, occurredAt])
    @@index([sessionId, occurredAt])
}

model UsageDeliveryOutbox {
    id            String   @id @default(cuid())
    usageEventId  String   @unique
    usageEvent    ProviderUsageEvent @relation(fields: [usageEventId], references: [id], onDelete: Cascade)
    status        String   @default("pending")
    attemptCount  Int      @default(0)
    nextAttemptAt DateTime @default(now())
    leaseUntil    DateTime?
    lastError     String?
    deliveredAt   DateTime?
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    @@index([status, nextAttemptAt])
    @@index([status, leaseUntil])
}

//
// Machines
//

model Machine {
    id                 String      @id
    accountId          String
    account            Account     @relation(fields: [accountId], references: [id])
    metadata           String // Encrypted - contains static machine info
    metadataVersion    Int         @default(0)
    daemonState        String? // Encrypted - contains dynamic daemon state
    daemonStateVersion Int         @default(0)
    dataEncryptionKey  Bytes?
    /// aplus §6-1 B1 — machineKey 의 서버 몫 봉투 (서버 서비스 공개키로
    /// wrap). 계정 몫(dataEncryptionKey)과 별개 컬럼이라 존재가 스키마에서
    /// 명시적으로 보인다. write-once — 회전은 별도 흐름.
    serverDataEncryptionKey Bytes?
    /// aplus-dev-studio specs/e2ee-machine-control-boundary R1 — the server's own
    /// RPC key, wrapped to the server service key. Separate from machineKey: it
    /// opens only the daemon's server lane, which runs an allowlist of
    /// non-content methods. Write-once on registration; key rotation replaces it.
    serverRpcKeyEnvelope Bytes?
    seq                Int         @default(0)
    active             Boolean     @default(true)
    lastActiveAt       DateTime    @default(now())
    createdAt          DateTime    @default(now())
    updatedAt          DateTime    @updatedAt
    accessKeys         AccessKey[]
    automationPublicKey Bytes?
    automationKeyVersion Int       @default(0)
    automationProtocolVersion Int  @default(1)
    automations        Automation[] @relation("AutomationTargetMachine")

    @@unique([accountId, id])
    @@index([accountId])
}

model UploadedFile {
    id        String   @id @default(cuid())
    accountId String
    account   Account  @relation(fields: [accountId], references: [id])
    path      String
    width     Int?
    height    Int?
    thumbhash String?
    reuseKey  String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([accountId, path])
    @@index([accountId])
}

model ServiceAccountToken {
    id         String    @id @default(cuid())
    accountId  String
    account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
    vendor     String
    token      Bytes // Encrypted token
    metadata   Json? // Optional vendor metadata
    lastUsedAt DateTime?
    createdAt  DateTime  @default(now())
    updatedAt  DateTime  @updatedAt

    @@unique([accountId, vendor])
    @@index([accountId])
}

//
// Artifacts
//

model Artifact {
    id                String   @id // UUID provided by client
    accountId         String
    account           Account  @relation(fields: [accountId], references: [id])
    header            Bytes // Encrypted header (can contain JSON)
    headerVersion     Int      @default(0)
    body              Bytes // Encrypted body
    bodyVersion       Int      @default(0)
    dataEncryptionKey Bytes // Encryption key for this artifact
    seq               Int      @default(0)
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    @@index([accountId])
    @@index([accountId, updatedAt(sort: Desc)])
}

//
// Access Keys
//

model AccessKey {
    id          String   @id @default(cuid())
    accountId   String
    account     Account  @relation(fields: [accountId], references: [id])
    machineId   String
    machine     Machine  @relation(fields: [accountId, machineId], references: [accountId, id])
    sessionId   String
    session     Session  @relation(fields: [sessionId], references: [id])
    data        String // Encrypted data
    dataVersion Int      @default(0)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@unique([accountId, machineId, sessionId])
    @@index([accountId])
    @@index([sessionId])
    @@index([machineId])
}

//
// Social Network - Relationships
//

enum RelationshipStatus {
    none
    requested
    pending
    friend
    rejected
}

model UserRelationship {
    fromUserId     String
    fromUser       Account            @relation("RelationshipsFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
    toUserId       String
    toUser         Account            @relation("RelationshipsTo", fields: [toUserId], references: [id], onDelete: Cascade)
    status         RelationshipStatus @default(pending)
    createdAt      DateTime           @default(now())
    updatedAt      DateTime           @updatedAt
    acceptedAt     DateTime?
    lastNotifiedAt DateTime?

    @@id([fromUserId, toUserId])
    @@index([toUserId, status])
    @@index([fromUserId, status])
}

//
// Feed
//

model UserFeedItem {
    id        String   @id @default(cuid())
    userId    String
    user      Account  @relation(fields: [userId], references: [id], onDelete: Cascade)
    counter   BigInt
    repeatKey String?
    /// [FeedBody]
    body      Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, counter])
    @@unique([userId, repeatKey])
    @@index([userId, counter(sort: Desc)])
}

//
// Key-Value Storage
//

model UserKVStore {
    id        String   @id @default(cuid())
    accountId String
    account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    key       String   // Unencrypted for indexing
    value     Bytes?   // Encrypted value, null when "deleted"
    version   Int      @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([accountId, key])
    @@index([accountId])
}

// Projects
//

model Project {
    scriptArtifacts ScriptArtifact[]
    id                   String              @id @default(cuid())
    accountId            String
    account              Account             @relation(fields: [accountId], references: [id])
    name                 String
    description          String              @default("")
    color                String              @default("#6366f1")
    /// [ProjectConfig]
    config               Json?
    isDefault            Boolean             @default(false)
    createdAt            DateTime            @default(now())
    updatedAt            DateTime            @updatedAt
    giteaRepo            String?
    automationViewerPublicKey Bytes?
    automationViewerKeyVersion Int @default(0)
    members              ProjectMember[]
    workspaces           Workspace[]
    mergeRequests        MergeRequest[]
    automations          Automation[]
    sessionFollowups     SessionFollowup[]

    @@index([accountId])
}

model ProjectMember {
    id          String            @id @default(cuid())
    projectId   String
    project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
    accountId   String
    account     Account           @relation(fields: [accountId], references: [id])
    role        String            @default("editor")
    status      String            @default("pending")
    invitedBy   String
    inviter     Account           @relation("ProjectMemberInviter", fields: [invitedBy], references: [id])
    createdAt   DateTime          @default(now())
    updatedAt   DateTime          @updatedAt

    @@unique([projectId, accountId])
    @@index([accountId])
    @@index([projectId])
}

model Workspace {
    id          String   @id @default(cuid())
    name        String
    projectId   String
    project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
    accountId   String
    account     Account  @relation(fields: [accountId], references: [id])
    branchName  String
    status      String   @default("active")
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    mergeRequests MergeRequest[]

    @@unique([projectId, branchName])
    @@index([projectId])
    @@index([accountId])
}

enum AutomationChangeKind {
    UPSERT
    TOMBSTONE
}

enum AutomationRunStatus {
    CLAIMED
    RUNNING
    COMPLETED
    FAILED
    CANCELLED
    EXPIRED
    ABANDONED
}

enum AutomationRunOutcome {
    WOKE
    SILENT
    SKIPPED_GATE
    ERROR
}

model Automation {
    id                 String    @id @default(cuid())
    projectId          String
    project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
    ownerAccountId     String
    ownerAccount       Account   @relation("AutomationOwner", fields: [ownerAccountId], references: [id])
    machineAccountId   String?
    machineId          String?
    targetMachine      Machine?  @relation("AutomationTargetMachine", fields: [machineAccountId, machineId], references: [accountId, id], onDelete: SetNull)
    revision           Int       @default(1)
    generation         Int       @default(1)
    payloadVersion     Int       @default(1)
    scriptRegistrationKey String?
    payloadCiphertext  Bytes
    viewerKeyId        String
    viewerKeyVersion   Int
    viewerKeyEnvelope  Bytes
    machineKeyVersion  Int
    machineKeyEnvelope Bytes
    paused             Boolean   @default(false)
    enabledAt          DateTime  @default(now())
    runRequestedAt     DateTime?
    deletedAt          DateTime?
    appliedRevision    Int       @default(0)
    appliedAt          DateTime?
    legacyMachineId    String?
    legacyAutomationId String?
    legacyMigrationPending Boolean   @default(false)
    legacyDesiredPaused     Boolean?
    createdAt          DateTime  @default(now())
    updatedAt          DateTime  @updatedAt
    runs               AutomationRun[]
    scriptRevisions    ScriptAutomationRevision[]
    scriptKeys         ScriptAutomationKeyEpoch[]
    scriptInvocations  ScriptInvocation[]

    @@unique([legacyMachineId, legacyAutomationId])
    @@unique([projectId, scriptRegistrationKey])
    @@index([projectId, deletedAt])
    @@index([ownerAccountId])
    @@index([machineAccountId, machineId, deletedAt])
}

// Deliberately has no FK to Automation: project hard-delete must leave a
// target-specific tombstone for daemons that were offline during deletion.
model AutomationChange {
    seq              BigInt               @id @default(autoincrement())
    automationId     String
    machineAccountId String
    machineId        String
    revision         Int
    generation       Int
    kind             AutomationChangeKind
    createdAt        DateTime             @default(now())

    @@unique([automationId, revision, machineAccountId, machineId, kind])
    @@index([machineAccountId, machineId, seq])
    @@index([automationId])
}

// A run row is both the atomic execution claim and the shared run history.
model AutomationRun {
    id                String                @id @default(cuid())
    automationId      String
    automation        Automation            @relation(fields: [automationId], references: [id], onDelete: Cascade)
    generation        Int
    scheduledFor      DateTime
    machineAccountId  String
    machineId         String
    status            AutomationRunStatus
    claimTokenHash    Bytes                 @unique
    claimExpiresAt    DateTime
    runLeaseExpiresAt DateTime?
    reportId          String?               @unique
    sessionId         String?
    outcome           AutomationRunOutcome?
    detailCiphertext  Bytes?
    failureCode       String?
    degradedCode      String?
    queueDepth         Int?
    queuePosition      Int?
    queueTotal         Int?
    queueEstimatedAt   DateTime?
    claimedAt         DateTime              @default(now())
    startedAt         DateTime?
    completedAt       DateTime?
    lateReport        Boolean               @default(false)
    createdAt         DateTime              @default(now())
    updatedAt         DateTime              @updatedAt

    @@unique([automationId, generation, scheduledFor])
    @@index([automationId, status])
    @@index([machineAccountId, machineId, status])
}

model ScriptArtifact {
    id        String @id
    projectId String
    project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
    digest    String
    encrypted Json
    revisions ScriptAutomationRevision[]
}

model ScriptAutomationRevision {
    automationId      String
    automation        Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
    revision          Int
    artifactId        String
    artifact          ScriptArtifact @relation(fields: [artifactId], references: [id], onDelete: NoAction)
    digest            String
    payloadCiphertext String
    admission         Json
    ready             Boolean @default(false)
    validationFailure String?
    nextRunAt         Float?
    scheduleInitialized Boolean @default(false)
    invocations       ScriptInvocation[]

    @@id([automationId, revision])
}

model ScriptAutomationKeyEpoch {
    id           String @id
    automationId String
    automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
    epoch        Int
    revoked      Boolean @default(false)
    expiresAt    Float
    rateWindow   Float @default(0)
    rateCount    Int @default(0)
}

model ScriptInvocation {
    id              String @id
    automationId    String
    automation      Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
    revision        Int
    scriptRevision  ScriptAutomationRevision @relation(fields: [automationId, revision], references: [automationId, revision], onDelete: NoAction)
    generation      Int
    trigger         String
    requestedBy     String
    keyId           String?
    keyEpoch        Int?
    idempotencyKey  String
    bodyHash        String
    snapshot        Json
    inputCiphertext String
    status          String @default("QUEUED")
    claimHash       String?
    leaseExpiresAt  Float?
    createdAt       Float
    startedAt       Float?
    completedAt     Float?
    exitCode        Int?
    failureCode     String?
    logCiphertext   String?
    cancelRequestedAt Float?
    scheduledFor    Float?
    missedCount     Int @default(0)

    @@unique([automationId, requestedBy, idempotencyKey])
    @@index([automationId, status, createdAt, id], map: "ScriptInvocation_fifo")
    // ScriptInvocation_active is a partial unique index in the SQL migration.
}

enum SessionFollowupStatus {
    WAITING
    DELIVERY_PENDING
    PAUSED
    COMPLETED
    CANCELLED
    FAILED
}

enum SessionFollowupTerminalCode {
    CLEAN
    LOW_OR_NIT_ONLY
    UNSTRUCTURED
    ROUNDS_EXHAUSTED
    USER_INTERVENTION
    STOPPED
    SESSION_UNAVAILABLE
    TARGET_MISMATCH
    DECRYPT_FAILED
    PERMISSION_REVOKED
}

enum SessionFollowupChangeKind {
    UPSERT
    TOMBSTONE
}

enum SessionFollowupHistoryKind {
    STARTED
    CONTINUATION_RESERVED
    CONTINUATION_DELIVERED
    TERMINATED
    PAUSED
    RESUMED
    STOPPED
    DELETED
}

// Durable control plane for a bounded sequence of prompts in one existing
// E2EE session. Payload and runtime detail remain opaque to the server.
model SessionFollowup {
    id                    String   @id @default(cuid())
    projectId             String
    project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
    ownerAccountId        String
    ownerAccount          Account  @relation("SessionFollowupOwner", fields: [ownerAccountId], references: [id])
    machineAccountId      String
    machineId             String
    // Deliberately no FK: machine deletion must not discard durable history or
    // block the existing machine lifecycle. Execution re-resolves this target.
    // Deliberately no FK: a deleted session must leave an auditable terminal
    // aggregate and a machine-targeted tombstone.
    sessionId             String
    revision              Int      @default(1)
    generation            Int      @default(1)
    step                  Int      @default(1)
    payloadVersion        Int      @default(1)
    payloadCiphertext     Bytes
    viewerKeyId           String
    viewerKeyVersion      Int
    viewerKeyEnvelope     Bytes
    machineKeyVersion     Int
    machineKeyEnvelope    Bytes
    status                SessionFollowupStatus @default(WAITING)
    terminalCode          SessionFollowupTerminalCode?
    totalRounds           Int
    currentRound          Int
    responseBoundarySeq   Int
    lastObservedSeq       Int
    pendingExpectedSeq    Int?
    pendingLocalId        String?  @unique
    claimTokenHash        Bytes?   @unique
    claimExpiresAt        DateTime?
    claimedGeneration     Int?
    claimedStep           Int?
    deletedAt             DateTime?
    completedAt           DateTime?
    createdAt             DateTime @default(now())
    updatedAt             DateTime @updatedAt
    history               SessionFollowupHistory[]

    // A migration-owned partial unique index on sessionId
    // prevents concurrent creation of multiple non-terminal loops.
    @@index([projectId, sessionId, deletedAt])
    @@index([machineAccountId, machineId, status, deletedAt])
}

// No FK by design: tombstones survive aggregate/project hard deletion.
model SessionFollowupChange {
    seq              BigInt @id @default(autoincrement())
    followupId       String
    machineAccountId String
    machineId        String
    revision         Int
    generation       Int
    kind             SessionFollowupChangeKind
    createdAt        DateTime @default(now())

    @@unique([followupId, revision, machineAccountId, machineId, kind])
    @@index([machineAccountId, machineId, seq])
    @@index([followupId])
}

model SessionFollowupHistory {
    id             String @id @default(cuid())
    followupId     String
    followup       SessionFollowup @relation(fields: [followupId], references: [id], onDelete: Cascade)
    generation     Int
    step           Int
    round          Int
    kind           SessionFollowupHistoryKind
    terminalCode   SessionFollowupTerminalCode?
    observedSeq    Int?
    detailCiphertext Bytes?
    createdAt      DateTime @default(now())

    @@index([followupId, createdAt(sort: Desc)])
}

model MergeRequest {
    id            String                @id @default(cuid())
    title         String
    description   String                @default("")
    projectId     String
    project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
    workspaceId   String
    workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    authorId      String
    author        Account               @relation(fields: [authorId], references: [id])
    status        String                @default("open")
    createdAt     DateTime              @default(now())
    updatedAt     DateTime              @updatedAt
    comments      MergeRequestComment[]

    @@index([projectId])
    @@index([workspaceId])
    @@index([authorId])
}

model MergeRequestComment {
    id              String       @id @default(cuid())
    mergeRequestId  String
    mergeRequest    MergeRequest @relation(fields: [mergeRequestId], references: [id], onDelete: Cascade)
    authorId        String
    author          Account      @relation(fields: [authorId], references: [id])
    body            String
    filePath        String?
    lineNumber      Int?
    createdAt       DateTime     @default(now())

    @@index([mergeRequestId])
}

//
// Voice Conversations — tracks ElevenLabs conversations per user for rate limiting
//

model VoiceConversation {
    id                         String   @id @default(cuid())
    accountId                  String
    account                    Account  @relation(fields: [accountId], references: [id])
    elevenLabsConversationId   String   @unique
    durationSecs               Int?     // Filled in lazily from ElevenLabs API
    createdAt                  DateTime @default(now())

    @@index([accountId, createdAt(sort: Desc)])
}

//
// Managed session authority (T04-B)
//
// Happy has no Run table of its own: the control plane owns run lifecycle and
// projects the parts this server must enforce. These three models are that
// projection plus the grants issued against it. Nothing here decides policy —
// the control plane does, under a signed assertion — but every scoped action is
// checked against these rows, so a stale or revoked grant stops working here.
//

/// Workspace-level authority. Ownership binding (tenant/project/workspace) is
/// immutable once created; the Happy account a run acts as is NOT pinned here,
/// because the same project may legitimately run under a different account
/// later — that lives on the grant and on the run.
model ManagedWorkspaceAuthority {
    workspaceId String @id
    tenantId    String
    projectId   String
    /// Runtime generation. A grant minted below the current epoch is refused
    /// immediately, without waiting for its own expiry.
    epoch       Int
    runtimeId   String
    /// Monotonic. Advances on every accepted projection update and is the CAS
    /// token the control plane sends as `expectedVersion`.
    version     Int    @default(0)
    /// Canonical digest of the body that produced the current version, so an
    /// identical retry is idempotent and a different body at the same version
    /// is a conflict rather than a silent overwrite.
    bodyDigest  String
    createdAt   BigInt
    updatedAt   BigInt

    runs   ManagedRunAuthority[]
    grants ManagedSessionGrant[]

    @@index([tenantId, projectId])
}

/// Per-run authority. Attempt history and cancellation move independently of
/// the workspace, so this carries its own monotonic version.
model ManagedRunAuthority {
    runId       String @id
    workspaceId String
    /// The Happy account this run acts as, pinned here rather than on the
    /// workspace: the same project may legitimately run under a different
    /// account later. Every grant is checked against this and against
    /// `Session.accountId`, so a grant cannot outlive a change of actor.
    accountId   String
    /// The only attempt that may hold a live grant.
    currentAttemptId String
    /// Terminal. Once set, no grant may be issued for this run under any
    /// attempt or family — a cancelled run must not come back under a new id.
    cancelledAt BigInt?
    version     Int    @default(0)
    bodyDigest  String
    createdAt   BigInt
    updatedAt   BigInt

    workspace ManagedWorkspaceAuthority @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict)
    grants    ManagedSessionGrant[]

    @@index([workspaceId])
    @@index([accountId])
}

/// One scoped credential. `family` is stable per (run, attempt, session) so a
/// renewal replaces its predecessor in place and a revoke tombstones the whole
/// family — issuing a fresh `grantId` cannot resurrect what was revoked.
/**
 * The highest ACL generation this server has seen for one viewer of one
 * session, and the compare-and-set point for every read-grant write.
 *
 * The parent owns the ACL and numbers its changes; this row is what makes a
 * *late* message from that parent harmless. Control-plane calls arrive over a
 * network that reorders, and both directions are dangerous: an old mint would
 * hand back access that was withdrawn, and an old revoke would withdraw access
 * that was re-granted. Comparing against the high-water mark refuses both,
 * whichever order they arrive in.
 *
 * Keyed per (session, viewer) rather than per project: a project-wide counter
 * would make any ACL change anywhere invalidate every session's read grants.
 */
model ManagedReadAclWatermark {
    sessionId       String
    viewerAccountId String
    /// Monotonic. Advanced by a mint or a revoke, never lowered, never reset.
    revision        Int
    updatedAt       BigInt

    @@id([sessionId, viewerAccountId])
}

model ManagedSessionGrant {
    grantId     String @id
    family      String
    /**
     * The run axes a **runner** grant is bound to.
     *
     * Null for a `transcript-read` grant, and that is the point: a transcript
     * outlives the run that produced it. A finished run, a stopped runtime and
     * a session that has since been replaced all still have transcripts
     * somebody is entitled to read, and requiring a live run to read one is
     * what made a dormant project unreadable.
     */
    workspaceId String?
    runId       String?
    attemptId   String?
    sessionId   String
    /// What this grant is **for**, and therefore what it may reach.
    ///
    /// Without it a grant handed to a browser for reading is the same object a
    /// runner uses to post messages and register tools — that is, giving
    /// somebody a transcript would give them execution on that session.
    ///
    /// `runner` is the historical behaviour and stays the default so existing
    /// rows and callers keep working. An unknown value is never folded into it:
    /// folding an unrecognised purpose into `runner` turns "we do not know what
    /// this is for" into full execution.
    ///
    /// 'runner' | 'transcript-read' | 'approval-control'
    purpose     String @default("runner")
    /// The account this run acts as. Compared against `Session.accountId` on
    /// every action; never inherited from the workspace.
    /// The account that owns the session. For a runner grant this is also the
    /// account the run acts as; for a read grant it is the authority the
    /// request is checked against, never a value the caller may assert.
    accountId   String
    /// Who is reading, when that is not the owner.
    ///
    /// A company project may be read by a member whose Happy account is not
    /// the session owner's. Null on a runner grant, where there is no separate
    /// viewer.
    viewerAccountId String?
    /// The session key envelope resealed for `viewerAccountId`.
    ///
    /// Produced by whoever holds the plaintext key — this server never does,
    /// and never invents one. Absent means the viewer cannot decrypt, which is
    /// reported as such rather than papered over with the owner's envelope.
    viewerDataEncryptionKey Bytes?
    epoch       Int?
    /// Authority versions this grant was minted against. A later projection
    /// update makes the grant stale without needing to touch this row.
    workspaceAuthorityVersion Int?
    runAuthorityVersion       Int?
    expiresAt   BigInt
    revokedAt   BigInt?
    /// Reason code only — never provider text or request content.
    revokedReason String?
    /// Set on a tombstone created by a revoke that arrived before any issue.
    tombstone   Boolean @default(false)
    /// The ACL generation a **read** grant was issued under.
    ///
    /// Part of the family, so a member removed and later re-added is issued
    /// against a different row than the one their removal tombstoned. Without
    /// it, re-adding somebody could only be made to work by clearing that
    /// tombstone — which would resurrect the bearer the removal withdrew.
    /// Null on a runner or approval grant, which are bound to a run instead.
    aclRevision Int?
    /// Monotonic renewal counter. A renewal supersedes the grant in place, so
    /// this is the compare-and-set token that keeps two control-plane replicas
    /// from both extending the same grant.
    renewalSeq  Int    @default(0)
    /// The control-plane request that produced this row, for exact-body retry.
    requestId   String
    bodyDigest  String
    createdAt   BigInt
    updatedAt   BigInt

    /// Optional because a read grant has no run: the transcript outlives it.
    workspace ManagedWorkspaceAuthority? @relation(fields: [workspaceId], references: [workspaceId], onDelete: Restrict)
    run       ManagedRunAuthority?       @relation(fields: [runId], references: [runId], onDelete: Restrict)

    /// At most one live grant per family: a renewal supersedes in place.
    @@unique([family])
    @@unique([requestId])
    @@index([sessionId, revokedAt])
    @@index([runId, attemptId])
    @@index([workspaceId, epoch])
}

/// The durable identity a managed Cloud daemon runs on.
///
/// A managed runtime has no human and no account of its own. The Machine it
/// registers as belongs to a customer's account, but the daemon must never
/// hold that account's bearer: it runs code the customer's agent can
/// influence, and an account bearer reaches every session on that account.
/// This row is what its own credential names.
///
/// Separate from key custody on purpose. This answers "is this daemon still
/// allowed to act"; the Machine's wrapped key answers "what can it read".
/// Revoking one does not silently invalidate the other, which is why both
/// exist.
model ManagedDaemonGrant {
    daemonGrantId String @id
    /// The account the Machine belongs to. Named by the credential, never
    /// acted as.
    accountId     String
    machineId     String
    runtimeId     String
    provisioningOperationId String
    workspaceId   String
    projectId     String
    /// The runtime generation this grant was issued for.
    epoch         Int
    /// Moved by a revocation. A credential from an older generation is refused
    /// even while this row still exists, so a withdrawal takes effect without
    /// waiting for a token to expire.
    generation    Int    @default(0)
    /// When the *grant* stops being usable. The credentials minted against it
    /// carry their own, shorter, expiry.
    expiresAt     BigInt
    revokedAt     BigInt?
    /// Reason code only — never provider text or request content.
    revokedReason String?
    /// The control-plane request that **created** this row, for exact-body
    /// retry. Immutable: a renewal that overwrote it would make the original
    /// issue retry miss its own row and collide on the unique index instead of
    /// converging.
    requestId     String
    bodyDigest    String
    /// The most recent renewal request, on its own axis so a renewal retry
    /// converges the same way an issue retry does.
    renewalRequestId String?
    renewalBodyDigest String?
    /// Until when the generation a renewal just superseded may still act.
    /// A renewal is delivered to the daemon over the socket that authenticated
    /// with the *previous* credential; refusing that generation the instant
    /// the new one exists refuses the delivery itself, and the daemon can never
    /// learn the credential that would let it back in. Bounded: after this the
    /// old generation is refused like any other. A revocation ignores it.
    supersededGraceUntil BigInt?
    /// The lowest generation still inside the grace. A renewal that lands while
    /// the previous grace is still open keeps the floor where it was, so a
    /// parent that renews twice (a restart, a second replica that never saw
    /// the undelivered credential) does not push the daemon two generations
    /// back and out. The previous credentials' own expiry still bounds it.
    graceFloorGeneration Int?
    createdAt     BigInt
    updatedAt     BigInt

    /// One live grant per runtime generation: a re-issue supersedes in place
    /// rather than leaving two credentials that both look current.
    @@unique([runtimeId, provisioningOperationId])
    @@unique([requestId])
    @@unique([renewalRequestId])
    @@index([accountId, machineId])
    @@index([workspaceId, epoch])
}
