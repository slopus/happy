// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider        = "prisma-client-js"
    previewFeatures = ["metrics", "relationJoins", "driverAdapters"]
}

generator json {
    provider = "prisma-json-types-generator"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

//
// Account
//

model Account {
    id              String      @id @default(cuid())
    publicKey       String      @unique
    seq             Int         @default(0)
    feedSeq         BigInt      @default(0)
    createdAt       DateTime    @default(now())
    updatedAt       DateTime    @updatedAt
    settings        String?
    settingsVersion Int         @default(0)
    cloudflareConnectionEpoch             Int     @default(0) @map("vercelConnectionEpoch")
    cloudflareConnectionState             String  @default("active") @map("vercelConnectionState")
    cloudflareConnectionNonce             String? @map("vercelConnectionNonce")
    cloudflareConnectionReplacementId     String? @map("vercelConnectionReplacementId")
    cloudflareConnectionReplacementStartedAt DateTime? @map("vercelConnectionReplacementStartedAt")
    githubUserId    String?     @unique
    githubUser      GithubUser? @relation(fields: [githubUserId], references: [id])

    // Profile
    firstName String?
    lastName  String?
    username  String? @unique
    /// [ImageRef]
    avatar    Json?

    Session             Session[]
    SessionChange       SessionChange[]
    sessionChangeCounter SessionChangeCounter?
    AccountPushToken    AccountPushToken[]
    TerminalAuthRequest TerminalAuthRequest[]
    AccountAuthRequest  AccountAuthRequest[]
    UsageReport         UsageReport[]
    Machine             Machine[]
    UploadedFile        UploadedFile[]
    ServiceAccountToken ServiceAccountToken[]
    CodexAccountProfile CodexAccountProfile[]
    CodexSessionGrant CodexSessionGrant[]
    CodexAccountAudit CodexAccountAudit[]
    codexAccountsMigratedAt DateTime?
    RelationshipsFrom   UserRelationship[]    @relation("RelationshipsFrom")
    RelationshipsTo     UserRelationship[]    @relation("RelationshipsTo")
    Artifact            Artifact[]
    AccessKey           AccessKey[]
    UserFeedItem        UserFeedItem[]
    UserKVStore         UserKVStore[]
    VoiceConversation   VoiceConversation[]
    PublicSessionShare  PublicSessionShare[]
    InteractivePreview InteractivePreview[]
    AppDelegation AppDelegation[]
    AppChatWorker AppChatWorker[]
    aiServices AIService[]
    aiServiceAuthorizations AIServiceAuthorization[]
    aiServiceBindings AIServiceBinding[]
    aiServiceCapabilitySnapshots AIServiceCapabilitySnapshot[]
}

model TerminalAuthRequest {
    id                String   @id @default(cuid())
    publicKey         String   @unique
    supportsV2        Boolean  @default(false)
    response          String?
    responseAccountId String?
    responseAccount   Account? @relation(fields: [responseAccountId], references: [id])
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt
}

model AccountAuthRequest {
    id                String   @id @default(cuid())
    publicKey         String   @unique
    response          String?
    responseAccountId String?
    responseAccount   Account? @relation(fields: [responseAccountId], references: [id])
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt
}

model AccountPushToken {
    id        String   @id @default(cuid())
    accountId String
    account   Account  @relation(fields: [accountId], references: [id])
    token     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([accountId, token])
}

//
// Sessions
//

model Session {
    id                String           @id @default(cuid())
    tag               String
    accountId         String
    account           Account          @relation(fields: [accountId], references: [id])
    metadata          String
    metadataVersion   Int              @default(0)
    agentState        String?
    agentStateVersion Int              @default(0)
    dataEncryptionKey Bytes?
    seq               Int              @default(0)
    active            Boolean          @default(true)
    lastActiveAt      DateTime         @default(now())
    createdAt         DateTime         @default(now())
    updatedAt         DateTime         @updatedAt
    messages          SessionMessage[]
    usageReports      UsageReport[]
    accessKeys        AccessKey[]
    publicShare       PublicSessionShare?
    interactivePreviews InteractivePreview[]

    @@unique([accountId, tag])
    @@index([accountId, updatedAt(sort: Desc)])
}

// Maintained by database triggers, including writes from older server binaries.
// Counter row locks serialize revisions through commit (a sequence cannot do this).
model SessionChangeCounter {
    accountId String @id
    account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
    revision BigInt @default(0)
}

// No Session FK: deletion tombstones must outlive the session itself.
model SessionChange {
    accountId String
    account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
    sessionId String
    revision BigInt
    deleted Boolean @default(false)
    lastMessageSeq Int @default(0)
    metadataVersion Int @default(0)
    agentStateVersion Int @default(0)

    @@id([accountId, sessionId])
    @@unique([accountId, revision])
}

model PublicSessionShare {
    id               String                    @id @default(cuid())
    publicId         String                    @unique
    accountId        String?
    account          Account?                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    sessionId        String?                   @unique
    session          Session?                  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    managementTokenHash Bytes?                 @unique
    createRequestId  String?                   @unique
    sourceProvider   String?
    expiresAt        DateTime?
    snapshot         Json?
    activeGeneration String?
    publishedAt      DateTime?
    revokedAt        DateTime?
    lifecycleVersion Int                       @default(1)
    createdAt        DateTime                  @default(now())
    updatedAt        DateTime                  @updatedAt
    assets           PublicSessionShareAsset[]
    drafts           PublicSessionShareDraft[]

    @@index([accountId, updatedAt(sort: Desc)])
    @@index([expiresAt])
}

model PublicSessionShareDraft {
    id               String                    @id
    shareId          String
    share             PublicSessionShare        @relation(fields: [shareId], references: [id], onDelete: Cascade)
    lifecycleVersion Int
    status           String                    @default("pending")
    expiresAt        DateTime
    createdAt        DateTime                  @default(now())
    updatedAt        DateTime                  @updatedAt
    assets           PublicSessionShareAsset[]

    @@index([shareId, status, expiresAt])
}

model PublicSessionShareAsset {
    id          String
    shareId     String
    share       PublicSessionShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
    generation  String
    draft       PublicSessionShareDraft @relation(fields: [generation], references: [id], onDelete: Cascade)
    name        String
    mimeType    String
    kind        String
    size        Int
    sha256      String
    uploadedAt  DateTime?
    storagePath String
    createdAt   DateTime           @default(now())

    @@id([shareId, generation, id])
    @@index([shareId, generation])
}

model SessionMessage {
    id        String   @id @default(cuid())
    sessionId String
    session   Session  @relation(fields: [sessionId], references: [id])
    localId   String?
    seq       Int
    /// [SessionMessageContent]
    content   Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([sessionId, localId])
    @@index([sessionId, seq])
}

model InteractivePreview {
    id                  String   @id
    accountId           String
    account             Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    sessionId           String?
    session             Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
    title               String
    status              String   @default("draft")
    manifest            Json
    cloudflareDeploymentId  String? @map("vercelDeploymentId")
    publicationAttemptId String?
    publicationCreateStartedAt DateTime?
    publicationReconcileRetryCount Int @default(0)
    publicationReconcileNextAttemptAt DateTime?
    publicationGeneration Int @default(0)
    connectionGeneration Int @default(0)
    cloudflareTeamId        String? @map("vercelTeamId")
    cloudflareScopeKnown    Boolean  @default(true) @map("vercelScopeKnown")
    stagingGeneration   String
    stagingCleanupPending Boolean @default(false)
    url                 String?
    publishedAt         DateTime?
    expiresAt           DateTime
    cleanupClaimedAt    DateTime?
    cleanupRetryCount   Int      @default(0)
    cleanupNextAttemptAt DateTime?
    errorCode           String?
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt
    assets              InteractivePreviewAsset[]

    @@index([accountId, createdAt(sort: Desc)])
    @@index([status, expiresAt])
    @@index([status, cleanupNextAttemptAt])
    @@index([status, publicationReconcileNextAttemptAt])
    @@index([sessionId, status])
}

model InteractivePreviewAsset {
    previewId   String
    preview     InteractivePreview @relation(fields: [previewId], references: [id], onDelete: Cascade)
    id          String
    path        String
    mimeType    String
    size        Int
    sha256      String
    storageKey  String
    uploadedAt  DateTime?
    createdAt   DateTime @default(now())

    @@id([previewId, id])
    @@unique([previewId, path])
}

//
// Github
//

model GithubUser {
    id        String    @id
    /// [GitHubProfile]
    profile   Json
    token     Bytes?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    Account   Account[]
}

model GithubOrganization {
    id        String   @id
    /// [GitHubOrg]
    profile   Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

//
// Utility
//

model GlobalLock {
    key       String   @id @default(cuid())
    value     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    expiresAt DateTime
}

model RepeatKey {
    key       String   @id
    value     String
    createdAt DateTime @default(now())
    expiresAt DateTime
}

model SimpleCache {
    key       String   @id
    value     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

//
// Usage Reporting
//

model UsageReport {
    id        String   @id @default(cuid())
    key       String
    accountId String
    account   Account  @relation(fields: [accountId], references: [id])
    sessionId String?
    session   Session? @relation(fields: [sessionId], references: [id])
    /// [UsageReportData]
    data      Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([accountId, sessionId, key])
    @@index([accountId])
    @@index([sessionId])
}

//
// Machines
//

model Machine {
    id                 String      @id
    accountId          String
    account            Account     @relation(fields: [accountId], references: [id])
    metadata           String // Encrypted - contains static machine info
    metadataVersion    Int         @default(0)
    daemonState        String? // Encrypted - contains dynamic daemon state
    daemonStateVersion Int         @default(0)
    dataEncryptionKey  Bytes?
    seq                Int         @default(0)
    active             Boolean     @default(true)
    lastActiveAt       DateTime    @default(now())
    createdAt          DateTime    @default(now())
    updatedAt          DateTime    @updatedAt
    accessKeys         AccessKey[]
    defaultCodexAccountProfileId String?
    defaultCodexAccountProfile CodexAccountProfile? @relation(fields: [defaultCodexAccountProfileId], references: [id], onDelete: SetNull)
    codexAccountBindingVersion Int @default(0)

    @@unique([accountId, id])
    @@index([accountId])
}

model UploadedFile {
    id        String   @id @default(cuid())
    accountId String
    account   Account  @relation(fields: [accountId], references: [id])
    path      String
    width     Int?
    height    Int?
    thumbhash String?
    reuseKey  String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([accountId, path])
    @@index([accountId])
}

model ServiceAccountToken {
    id         String    @id @default(cuid())
    accountId  String
    account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
    vendor     String
    token      Bytes // Encrypted token
    metadata   Json? // Optional vendor metadata
    lastUsedAt DateTime?
    createdAt  DateTime  @default(now())
    updatedAt  DateTime  @updatedAt

    @@unique([accountId, vendor])
    @@index([accountId])
}

model CodexAccountProfile {
    id String @id @default(uuid())
    accountId String
    account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
    displayName String
    externalAccountFingerprint String
    credential Bytes
    credentialVersion Int @default(1)
    status String @default("available")
    lastValidatedAt DateTime?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    machines Machine[]
    quota CodexQuotaSnapshot?

    @@unique([accountId, externalAccountFingerprint])
    @@unique([accountId, displayName])
}

model CodexQuotaSnapshot {
    codexAccountProfileId String @id
    profile CodexAccountProfile @relation(fields: [codexAccountProfileId], references: [id], onDelete: Cascade)
    weeklyUsedPercent Float
    weeklyResetsAt DateTime
    observedAt DateTime
    credentialVersion Int
    sourceSessionId String
}

// Redeemed grants retain only non-secret launch audit data after profile deletion.
// The grant value itself is never stored; only its SHA-256 digest is persisted.
model CodexSessionGrant {
    serviceAuthority Json?
    id String @id @default(uuid())
    accountId String
    account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
    machineId String
    codexAccountProfileId String
    displayNameSnapshot String
    credentialVersion Int
    lastCredentialVersion Int
    bindingVersion Int
    digest String @unique
    expiresAt DateTime
    redeemedAt DateTime?
    sourceSessionId String?
    createdAt DateTime @default(now())

    @@index([accountId, codexAccountProfileId])
    @@index([expiresAt])
}

model CodexAccountAudit {
    id String @id @default(uuid())
    accountId String
    account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
    action String
    profileId String?
    machineId String?
    credentialVersion Int?
    createdAt DateTime @default(now())

    @@index([accountId, createdAt])
}

//
// Artifacts
//

model Artifact {
    id                String   @id // UUID provided by client
    accountId         String
    account           Account  @relation(fields: [accountId], references: [id])
    header            Bytes // Encrypted header (can contain JSON)
    headerVersion     Int      @default(0)
    body              Bytes // Encrypted body
    bodyVersion       Int      @default(0)
    dataEncryptionKey Bytes // Encryption key for this artifact
    seq               Int      @default(0)
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    @@index([accountId])
    @@index([accountId, updatedAt(sort: Desc)])
}

//
// Access Keys
//

model AccessKey {
    id          String   @id @default(cuid())
    accountId   String
    account     Account  @relation(fields: [accountId], references: [id])
    machineId   String
    machine     Machine  @relation(fields: [accountId, machineId], references: [accountId, id])
    sessionId   String
    session     Session  @relation(fields: [sessionId], references: [id])
    data        String // Encrypted data
    dataVersion Int      @default(0)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@unique([accountId, machineId, sessionId])
    @@index([accountId])
    @@index([sessionId])
    @@index([machineId])
}

//
// Social Network - Relationships
//

enum RelationshipStatus {
    none
    requested
    pending
    friend
    rejected
}

model UserRelationship {
    fromUserId     String
    fromUser       Account            @relation("RelationshipsFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
    toUserId       String
    toUser         Account            @relation("RelationshipsTo", fields: [toUserId], references: [id], onDelete: Cascade)
    status         RelationshipStatus @default(pending)
    createdAt      DateTime           @default(now())
    updatedAt      DateTime           @updatedAt
    acceptedAt     DateTime?
    lastNotifiedAt DateTime?

    @@id([fromUserId, toUserId])
    @@index([toUserId, status])
    @@index([fromUserId, status])
}

//
// Feed
//

model UserFeedItem {
    id        String   @id @default(cuid())
    userId    String
    user      Account  @relation(fields: [userId], references: [id], onDelete: Cascade)
    counter   BigInt
    repeatKey String?
    /// [FeedBody]
    body      Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, counter])
    @@unique([userId, repeatKey])
    @@index([userId, counter(sort: Desc)])
}

//
// Key-Value Storage
//

model UserKVStore {
    id        String   @id @default(cuid())
    accountId String
    account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    key       String   // Unencrypted for indexing
    value     Bytes?   // Encrypted value, null when "deleted"
    version   Int      @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([accountId, key])
    @@index([accountId])
}

//
// Voice Conversations — tracks ElevenLabs conversations per user for rate limiting
//

model VoiceConversation {
    id                         String   @id @default(cuid())
    accountId                  String
    account                    Account  @relation(fields: [accountId], references: [id])
    elevenLabsConversationId   String   @unique
    durationSecs               Int?     // Filled in lazily from ElevenLabs API
    createdAt                  DateTime @default(now())

    @@index([accountId, createdAt(sort: Desc)])
}

// Separate authorization/data plane: never contains an account secret or token.
model AppDelegation {
    protocol Int @default(1)
    id String @id
    appId String
    storedBytes Int @default(0)
    challengeHash String
    publicKey String
    state String @default("pending")
    requestExpiresAt DateTime
    accountId String?
    account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
    machineId String?
    expiresAt DateTime?
    credentialHash String?
    appEnvelope String?
    machineEnvelope String?
    createdAt DateTime @default(now())
    conversations AppChatConversation[]
    @@index([accountId, createdAt])
    @@index([requestExpiresAt])
}

model AppChatWorker {
    nativeSessions Boolean @default(false)
    serviceProtocol String?
    servicePublicKey String?
    serviceClaudeIdentity String?
    serviceClaudeObservedAt DateTime?
    engines Json @default("[]")
    machineId String @id
    accountId String
    account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
    protocol Int
    activeUntil DateTime
}

model AppChatConversation {
    id String @id
    grantId String
    grant AppDelegation @relation(fields: [grantId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())
    turns AppChatTurn[]
    @@index([grantId, createdAt])
}

model AppChatTurn {
    sessionId String?
    phase String?
    bindingId String?
    binding AIServiceBinding? @relation(fields: [bindingId], references: [id])
    requestId String?
    actual Json?
    serviceError Json?
    startedAt DateTime?
    completedAt DateTime?
    @@unique([bindingId, requestId])
    minimumProtocol Int @default(1)
    id String @id
    conversationId String
    conversation AppChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    input String
    output String?
    sequence Int @default(0)
    state String @default("queued")
    lease String?
    leaseUntil DateTime?
    deadline DateTime
    createdAt DateTime @default(now())
    @@index([conversationId, createdAt])
    @@index([state, createdAt])
}

// Safe service configuration and immutable audit data.
model AIService {
    id String @id @default(uuid())
    ownerId String
    owner Account @relation(fields: [ownerId], references: [id])
    name String
    enabled Boolean @default(true)
    revision Int @default(1)
    deletedAt DateTime?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    revisions AIServiceRevision[]
    authorizations AIServiceAuthorization[]
    @@index([ownerId, createdAt])
}

model AIServiceRevision {
    serviceId String
    service AIService @relation(fields: [serviceId], references: [id])
    revision Int
    config Json
    accountFingerprint String
    createdAt DateTime @default(now())
    bindings AIServiceBinding[]
    @@id([serviceId, revision])
}

model AIServiceApplication {
    appId String @id
    policy Json
    enabled Boolean @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    authorizations AIServiceAuthorization[]
    bindings AIServiceBinding[]
}

// Scoped bearer digests and recipient-sealed keys. No clear key or native credential is stored here.
model AIServiceAuthorization {
    credentialDigest String?
    machineEnvelopes Json?
    targetFingerprints Json?
    id String @id
    ownerId String
    owner Account @relation(fields: [ownerId], references: [id])
    appId String
    app AIServiceApplication @relation(fields: [appId], references: [appId])
    serviceId String
    service AIService @relation(fields: [serviceId], references: [id])
    kind String
    scope Json
    allowModelOverride Boolean @default(false)
    allowReasoningOverride Boolean @default(false)
    expiresAt DateTime?
    revokedAt DateTime?
    createdAt DateTime @default(now())
    bindings AIServiceBinding[]
    @@index([ownerId, appId, serviceId])
}

model AIServiceBinding {
    historyRequests AIServiceHistoryRequest[]
    sessionId String? @unique
    historyRequestId String?
    historyDeadline DateTime?
    historyCiphertext String?
    appConversationId String?
    creationInput Json?
    turns AppChatTurn[]
    id String @id
    ownerId String
    owner Account @relation(fields: [ownerId], references: [id])
    appId String
    app AIServiceApplication @relation(fields: [appId], references: [appId])
    serviceId String
    revision Int
    serviceRevision AIServiceRevision @relation(fields: [serviceId, revision], references: [serviceId, revision])
    authorizationId String?
    authorization AIServiceAuthorization? @relation(fields: [authorizationId], references: [id])
    snapshot Json
    accountFingerprint String
    capabilityObservedAt DateTime
    createdAt DateTime @default(now())
    @@index([ownerId, appId, serviceId])
    @@unique([authorizationId, appId, appConversationId])
}

// Display cache only. Binding creation always asks the trusted source for a live check.
model AIServiceCapabilitySnapshot {
    ownerId String
    owner Account @relation(fields: [ownerId], references: [id])
    targetKey String
    catalog Json
    observedAt DateTime
    @@id([ownerId, targetKey])
}

// Discovery jobs carry no message key or model input. They are never replayed.
model AIServiceProbe {
    id String @id
    ownerId String
    machineId String
    principal Json
    target Json
    fingerprint String
    state String @default("queued")
    lease String?
    deadline DateTime
    catalog Json?
    error String?
    createdAt DateTime @default(now())
    @@index([machineId, state, createdAt])
}

model AIServiceBusinessPrompt {
    id String
    version String
    body String
    @@id([id, version])
}

// Short-lived request-specific encrypted snapshots; bindings retain immutable execution authority.
model AIServiceHistoryRequest {
    id String @id
    bindingId String
    binding AIServiceBinding @relation(fields: [bindingId], references: [id])
    sessionId String
    state String @default("queued")
    ciphertext String?
    error String?
    deadline DateTime
    createdAt DateTime @default(now())
    @@index([bindingId, state, deadline])
}
