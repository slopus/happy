{
  "manifest_version": 3,
  "name": "Happy Browser Bridge",
  "version": "0.2.0",
  "key": "",
  "description": "Lets a happy CLI session control this logged-in Chrome profile through the local daemon bridge.",
  "permissions": ["tabs", "storage", "scripting", "debugger", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "src/icons/icon-16.png",
    "32": "src/icons/icon-32.png",
    "48": "src/icons/icon-48.png",
    "128": "src/icons/icon-128.png"
  },
  "action": {
    "default_title": "Happy Browser Bridge",
    "default_icon": {
      "16": "src/icons/icon-16.png",
      "32": "src/icons/icon-32.png",
      "48": "src/icons/icon-48.png",
      "128": "src/icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/options.html"
}
