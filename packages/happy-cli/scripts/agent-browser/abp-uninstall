#!/usr/bin/env bash
# abp-uninstall — remove the Agent Browser services from execution machine H.
#
#   abp-uninstall [--dry-run] [--purge]
#
# Order matters: the owner firewall rules are what confine Claude (agent-sbx),
# so they go last and only after every session is verifiably gone:
#   1. fence new sessions: the sudoers drop-in (the only way to start Claude as
#      agent-sbx) is removed and the Happy daemon stopped;
#   2. every process of agent-sbx and agent (sessions survive a daemon stop by
#      design) gets SIGTERM, then SIGKILL, and none may remain — otherwise the
#      firewall rules are KEPT and the script exits 1;
#   3. stack (fence, drain, stop), containers, networks, browser egress rules;
#   4. owner firewall rules, units, tmpfiles entry, tools.
# Run it from a root or operator session, not from a shell of the agent user
# (that shell is terminated in step 2).
#
# Default KEEPS the profile and journal volumes (abp-profile-*, abp-state),
# /etc/abp, /var/lib/abp (secrets, image digests), the mandatory sandbox policy,
# the Happy package and the accounts, so abp-install can bring the machine back
# without losing tasks. --purge also deletes those volumes, images, /etc/abp,
# /var/lib/abp, the Happy package and the sandbox/egress policies. Accounts and
# their homes are never deleted (they hold the agent's Happy and Claude logins).
set -euo pipefail
export LC_ALL=C
DRY_RUN=0
PURGE=0
LABEL=ai.saycode.abp=stack
LIBEXEC=/usr/local/libexec/abp
SESSION_USERS="agent-sbx agent"
TERM_WAIT_S=${ABP_UNINSTALL_TERM_WAIT_S:-10}

# Stable across bash versions: plain words as they are, anything else single-quoted.
quote() {
    local out="" arg
    for arg in "$@"; do
        case "$arg" in
            "" | *[!A-Za-z0-9_./:=,@+%{}-]*) out="$out '$(printf '%s' "$arg" | sed "s/'/'\\\\''/g")'" ;;
            *) out="$out $arg" ;;
        esac
    done
    printf '%s' "${out# }"
}
run() { if [ "$DRY_RUN" = 1 ]; then printf '+ %s\n' "$(quote "$@")"; else "$@"; fi; }
# Best effort: a half-installed machine must still uninstall.
try() { run "$@" || printf 'abp-uninstall: warning: %s failed\n' "$1" >&2; }
say() { printf '== %s\n' "$*"; }
listed() { if [ "$DRY_RUN" = 1 ]; then printf '<%s>\n' "$1"; else docker "$@" 2>/dev/null || true; fi; }

fence_sessions() {
    say "fence new sessions (no sudo path to agent-sbx, daemon stopped)"
    try rm -f /etc/sudoers.d/abp-agent-sbx
    try systemctl disable --now abp-happy-daemon.service
}

# Terminates every process of the session users; returns 1 if any survives SIGKILL.
terminate_sessions() {
    local user signal waited left=""
    say "terminate sessions (${SESSION_USERS// /, })"
    for signal in TERM KILL; do
        for user in $SESSION_USERS; do
            if id -u "$user" >/dev/null 2>&1 || [ "$DRY_RUN" = 1 ]; then run pkill "-$signal" -u "$user" || true; fi
        done
        [ "$DRY_RUN" = 1 ] && continue
        for ((waited = 0; waited < TERM_WAIT_S * 2; waited++)); do
            left=""
            for user in $SESSION_USERS; do
                if id -u "$user" >/dev/null 2>&1 && pgrep -u "$user" >/dev/null 2>&1; then left="$left $user"; fi
            done
            [ -z "$left" ] && return 0
            sleep 0.5
        done
    done
    [ "$DRY_RUN" = 1 ] && return 0
    printf 'abp-uninstall: processes of%s survived SIGKILL (pgrep -u <user>)\n' "$left" >&2
    return 1
}

stop_stack() {
    say "stack (fence, drain, Runtime first), containers, networks, browser egress rules"
    try systemctl disable --now abp-stack.service
    local id
    for id in $(listed ps -aq --filter "label=$LABEL"); do try docker rm -f "$id"; done
    for id in $(listed network ls -q --filter "label=$LABEL"); do try docker network rm "$id"; done
    try systemctl disable --now abp-egress-proxy.service
    try systemctl disable abp-egress.service
    if [ "$DRY_RUN" = 1 ] || [ -x "$LIBEXEC/abp-firewall" ]; then try "$LIBEXEC/abp-firewall" remove-egress; fi
}

remove_isolation() {
    say "owner firewall rules (sessions are gone)"
    if [ "$DRY_RUN" = 1 ] || [ -x "$LIBEXEC/abp-firewall" ]; then try "$LIBEXEC/abp-firewall" remove; fi
    try systemctl disable abp-firewall.service
}

remove_files() {
    say "units, tmpfiles, tools"
    try rm -f /etc/systemd/system/abp-firewall.service /etc/systemd/system/abp-egress.service /etc/systemd/system/abp-egress-proxy.service \
        /etc/systemd/system/abp-stack.service /etc/systemd/system/abp-happy-daemon.service
    try systemctl daemon-reload
    try rm -f /etc/tmpfiles.d/abp.conf /usr/local/sbin/abp-stack
    try rm -rf "$LIBEXEC"
    if [ "$DRY_RUN" = 1 ] || [ -L /usr/local/bin/happy ]; then try rm -f /usr/local/bin/happy; fi
}

purge() {
    say "purge: volumes, images, configuration, secrets, Happy package"
    local id image
    for id in $(listed volume ls -q --filter "label=$LABEL"); do try docker volume rm "$id"; done
    if [ "$DRY_RUN" = 1 ]; then
        try docker image rm "<current and previous digests from /var/lib/abp/stack-state.json>"
    elif [ -s /var/lib/abp/stack-state.json ]; then
        for image in $(/usr/bin/node -e 'const s=JSON.parse(require("fs").readFileSync("/var/lib/abp/stack-state.json","utf8"));for(const d of [s.current,s.previous])if(d)console.log(d.runtime+"\n"+d.browser)'); do
            try docker image rm "$image"
        done
    fi
    try rm -rf /etc/abp /var/lib/abp /opt/abp /run/abp /run/abp-mcp
    try rm -f /etc/aplus/sandbox-policy.json /etc/aplus/claude-sandbox.json
    say "accounts agent, agent-sbx, abp-proxy, abp-runtime, abp-browser and groups abp-session, abp-work were kept (userdel/groupdel by hand if wanted)"
}

main_uninstall() {
    fence_sessions
    if ! terminate_sessions; then
        say "KEPT the owner firewall rules and everything else: stop the remaining processes, then run abp-uninstall again"
        return 1
    fi
    stop_stack
    remove_isolation
    remove_files
    if [ "$PURGE" = 0 ]; then
        say "kept: volumes abp-state and abp-profile-*, /etc/abp, /var/lib/abp, /etc/aplus/sandbox-policy.json, /opt/abp, accounts (use --purge to delete)"
        return 0
    fi
    purge
}

# Sourcing (tests) loads the functions only.
if [ "${BASH_SOURCE[0]}" != "$0" ]; then return 0; fi
while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run) DRY_RUN=1 ;;
        --purge) PURGE=1 ;;
        *) echo "usage: abp-uninstall [--dry-run] [--purge]" >&2; exit 2 ;;
    esac
    shift
done
if [ "$DRY_RUN" = 0 ] && [ "$(id -u)" != 0 ]; then echo "abp-uninstall: run as root" >&2; exit 1; fi
main_uninstall
