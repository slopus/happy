# S3 mode against the withminio.sh MinIO; tsserver.sh / rsserver.sh append -ts / -rs
# to the bucket and the public URL. GitHub settings for the avatar upload path.
S3_HOST=127.0.0.1
S3_PORT=9187
S3_USE_SSL=false
S3_ACCESS_KEY=compatadmin
S3_SECRET_KEY=compatsecret
S3_BUCKET=happy
S3_REGION=us-east-1
S3_PUBLIC_URL=http://127.0.0.1:9187/happy
GITHUB_CLIENT_ID=Iv1.compat-client
GITHUB_CLIENT_SECRET=compat-client-secret
GITHUB_REDIRECT_URL=https://example.test/callback
