 internal const val RECEIVE_CAPACITY = 1024
+
+/** What kind of address [host] is, for a trace that must not carry the address itself. */
+internal fun endpointClass(host: String): String {
+    IpAddress.parse4(host)?.let { b ->
+        val a = b[0].u(); val c = b[1].u()
+        return when {
+            a == 10 || a == 172 && c in 16..31 || a == 192 && c == 168 -> "private4"
+            a == 100 && c in 64..127 -> "cgnat4"
+            a == 169 && c == 254 -> "linklocal4"
+            a == 127 -> "loopback4"
+            else -> "public4"
+        }
+    }
+    val b = IpAddress.parse6(host) ?: return "unknown"
+    return when {
+        b.copyOfRange(0, 10).all { it == 0.toByte() } && b[10] == 0xff.toByte() && b[11] == 0xff.toByte() -> "mapped4." + endpointClass(IpAddress.format4(b.copyOfRange(12, 16)))
+        b[0].u() and 0xe0 == 0x20 -> "global6"
+        b[0].u() and 0xfe == 0xfc -> "ula6"
+        b[0].u() == 0xfe && b[1].u() and 0xc0 == 0x80 -> "linklocal6"
+        else -> "other6"
+    }
+}
