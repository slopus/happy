+package io.tailcat
+
+import kotlin.test.Test
+import kotlin.test.assertEquals
+
+class EndpointClassTest {
+    @Test
+    fun namesTheKindOfAddressOnly() {
+        assertEquals(
+            listOf("private4", "private4", "private4", "cgnat4", "public4", "linklocal4", "global6", "ula6", "mapped4.public4", "unknown"),
+            listOf("192.168.1.7", "10.0.0.2", "172.20.1.1", "100.100.1.1", "8.8.8.8", "169.254.3.4", "2001:db8::1", "fd00::5", "::ffff:8.8.4.4", "fe80::1%wlan0").map(::endpointClass),
+        )
+    }
+}
