@@ -0,0 +1,35 @@
+package io.tailcat
+
+import io.tailcat.platform.Endpoint
+import kotlin.test.Test
+import kotlin.test.assertEquals
+
+// Vectors from tailscale.com/net/stun, whose ParseBindingRequest every DERP's STUN server runs.
+class StunRequestTest {
+    private val transaction = ByteArray(12) { it.toByte() }
+
+    @Test
+    fun carriesTheSoftwareAndFingerprintTailscaleServersRequire() {
+        // stun.Request: header, SOFTWARE "tailnode", FINGERPRINT last.
+        assertEquals(
+            "000100142112a442000102030405060708090a0b802200087461696c6e6f6465802800048aabad90",
+            Stun.request(transaction).hex(),
+        )
+    }
+
+    @Test
+    fun readsTheMappedAddressATailscaleServerReplies() {
+        // stun.Response for 203.0.113.7:41641 and [2001:db8::1]:41641.
+        assertEquals(
+            Endpoint("203.0.113.7", 41641),
+            Stun.response("0101000c2112a442000102030405060708090a0b00200008000183bbea12d545".unhex(), transaction),
+        )
+        assertEquals(
+            Endpoint("2001:db8::1", 41641),
+            Stun.response("010100182112a442000102030405060708090a0b00200014000283bb0113a9fa000102030405060708090a0a".unhex(), transaction),
+        )
+    }
+
+    private fun ByteArray.hex() = joinToString("") { (it.toInt() and 255).toString(16).padStart(2, '0') }
+    private fun String.unhex() = ByteArray(length / 2) { substring(2 * it, 2 * it + 2).toInt(16).toByte() }
+}
