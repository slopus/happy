<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- app.config.js android.permissions; asked for at runtime (push/PushPermission.kt) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The QR scanner's camera (ui/connect/QrScannerActivity.kt), asked for when a scan starts.
         A phone without one still installs; the scan then asks for the link. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Removal markers are absent from the merged manifest; lint still inspects them. -->
    <!-- ElevenLabs uses audio only; remove LiveKit's unused screen capture. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" tools:node="remove" />

    <!-- expo-store-review's isAvailableAsync looks for the Play Store (ui/home/ReviewPrompt.kt). -->
    <queries>
        <package android:name="com.android.vending" />
        <!-- Whether anything on the phone can open a conversation's video or file. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:name=".HappyApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Happy">
        <service android:name="io.livekit.android.room.track.screencapture.ScreenCaptureService"
            tools:node="remove" tools:ignore="MissingClass" />
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- app.config.js scheme: happy://terminal?<key> (ui/connect/DeepLinks.kt) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="happy" />
            </intent-filter>
        </activity>
        <!-- Our QR scanner (ui/connect/QrScanner.kt): a full-screen camera, started for a result. -->
        <activity
            android:name=".ui.connect.QrScannerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="false"
            android:theme="@style/Theme.Happy.Scanner" />
        <!-- Pushes relayed by Expo arrive as FCM data messages (push/PushServices.kt). -->
        <service
            android:name=".push.HappyMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- sync.ts's scheduled "Message not sent" (push/BackgroundSendNotifications.kt). -->
        <receiver
            android:name=".push.BackgroundSendReceiver"
            android:exported="false" />
        <!--
          Hands one conversation media file at a time to whatever opens it,
          read-only and per URI (conversation/MediaFiles.kt). It shares the
          one directory conversation_media_paths.xml names and nothing else,
          and no other app may call it.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.conversation.media"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/conversation_media_paths" />
        </provider>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/notification_icon" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="default" />
    </application>

</manifest>
