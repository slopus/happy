    <string name="document_outdent">Outdent</string>
    <string name="document_divider">Divider</string>
    <string name="document_hide_keyboard">Hide Keyboard</string>

    <!-- What TalkBack says of a line beyond its text (iOS Strings.Documents). -->
    <string name="document_task_done">Done</string>
    <string name="document_task_not_done">Not done</string>
    <string name="document_picture">Picture</string>
    <string name="document_table">Table</string>
    <string name="document_unsupported">Something Happy can’t show here</string>

    <!-- This phone's name for desktop's cursor label when the profile has none (iOS Strings.Documents.someone). -->
    <string name="document_someone">Someone</string>

    <!-- A document's history (iOS DocumentHistoryViewController). -->
    <string name="document_history">History</string>
    <string name="document_history_empty">No changes yet</string>
    <string name="document_agent">An agent</string>
    <string name="document_conversion">Made from Markdown</string>
    <string name="document_current">Current version</string>
    <string name="document_version">Version %1$d</string>

    <!-- Who else has the document open, read by TalkBack on their faces in the bar (iOS Strings.Documents.editing). -->
    <string name="document_here_one">%1$s is here</string>
    <string name="document_here_many">%1$s are here</string>



    <!-- Who is in a Surface, atop its menu (desktop surfaceMembersText). -->
    <string name="surface_members_none">Nobody has joined</string>
    <string name="surface_members_two">%1$s and %2$s</string>
    <plurals name="surface_members_more">
        <item quantity="one">%1$s, %2$s and %3$d other</item>
        <item quantity="other">%1$s, %2$s and %3$d others</item>
    </plurals>
    <string name="surface_created_by">Created by %1$s</string>
    <string name="surface_added_by">Added by %1$s</string>


    <!-- An artifact, bot or task kept among the Surfaces (desktop HappyAgentSurfaceReferencePage). -->
    <string name="surface_open_artifact">Open artifact</string>
    <string name="surface_open_chat">Open chat</string>
    <string name="surface_unavailable">%1$s isn’t available.</string>
    <string name="surface_gone_deleted">It was deleted, or you can’t see it. It stays here in case it comes back.</string>
    <string name="surface_gone_archived">It was archived, or you can’t see it. It stays here in case it comes back.</string>

    <!-- A Surface's one shared chat, from its menu (desktop b3204bde). -->
    <string name="surface_chat">Chat</string>
    <string name="surface_chat_failed">The chat couldn’t be opened</string>
</resources>
