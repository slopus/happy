<?xml version="1.0" encoding="utf-8"?>
<!--
  Leaving a Surface from an agent connection's home, the agent chat's
  jump to the newest message and the document Surface's editor
  (ui/connection, ui/conversation, ui/surfaces, ui/documents). Not in
  happy-app's catalogs; written here, with every supported language in its
  own values-*/strings_surfaces.xml.
-->
<resources>
    <!-- iOS's Strings.leaveSurface: desktop's menu says it. -->
    <string name="surface_leave">Leave</string>
    <string name="surface_leave_title">Leave “%1$s”?</string>
    <string name="surface_leave_message">It goes from your list on all your devices. Everyone else in it keeps it.</string>
    <string name="surface_leave_failed">Couldn\'t leave “%1$s”</string>
    <string name="surface_leave_no_answer">The agent didn\'t answer. Try again in a moment.</string>

    <!-- iOS's Strings.jumpToLatest and jumpWorking, for TalkBack. -->
    <string name="conversation_jump_to_latest">Jump to latest</string>
    <string name="conversation_jump_working">working</string>

    <!-- Desktop de78af49: opening a Surface the person isn't in joins it; a refusal is said while it stays open. -->
    <string name="surface_join_failed">Couldn’t join “%1$s”</string>

    <!-- Desktop's missing Surface page: a Surface this computer doesn't know. -->
    <string name="surface_missing">This isn’t here. It may belong to a Happy Agent this one can’t reach.</string>

    <!-- A document Surface (iOS Strings.Documents, desktop DocumentSurface): its bar, menu and status words. -->
    <string name="document_untitled">Untitled</string>
    <string name="document_saved">Saved</string>
    <string name="document_saving">Saving…</string>
    <string name="document_waiting">Waiting to sync</string>
    <string name="document_unavailable">This document couldn’t be opened.</string>
    <string name="document_markdown_only">Editing this document needs a newer Happy Agent.</string>
    <string name="document_gone">This document is gone.</string>
    <string name="document_refused">The agent didn’t take a change, so this document was read again.</string>
    <string name="document_rename_title">Rename Document</string>
    <string name="document_name">Name</string>

    <!-- The formatting bar over the keyboard and its text style menu (iOS DocumentToolbar). -->
    <string name="document_text_style">Text Style</string>
    <string name="document_text">Text</string>
    <string name="document_heading">Heading %1$d</string>
    <string name="document_bold">Bold</string>
    <string name="document_italic">Italic</string>
    <string name="document_strike">Strikethrough</string>
    <string name="document_code">Code</string>
    <string name="document_link">Link</string>
    <string name="document_bullets">Bulleted List</string>
    <string name="document_numbers">Numbered List</string>
    <string name="document_checklist">Checklist</string>
    <string name="document_quote">Quote</string>
    <string name="document_code_block">Code Block</string>
