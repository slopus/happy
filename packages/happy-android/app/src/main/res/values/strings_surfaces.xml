  jump to the newest message (ui/connection, ui/conversation). Not in
  happy-app's catalogs; written here, with every supported language in its
  own values-*/strings_surfaces.xml.
-->
<resources>
    <!-- iOS's Strings.leaveSurface: desktop's menu says it. -->
    <string name="surface_leave">Leave</string>
    <string name="surface_leave_title">Leave “%1$s”?</string>
    <string name="surface_leave_message">It goes from your list on all your devices. Everyone else in it keeps it.</string>
    <string name="surface_leave_failed">Couldn\'t leave “%1$s”</string>
    <string name="surface_leave_no_answer">The agent didn\'t answer. Try again in a moment.</string>

    <!-- iOS's Strings.jumpToLatest and jumpWorking, for TalkBack. -->
    <string name="conversation_jump_to_latest">Jump to latest</string>
    <string name="conversation_jump_working">working</string>

    <!-- Desktop de78af49: opening a Surface the person isn't in joins it; a refusal is said while it stays open. -->
    <string name="surface_join_failed">Couldn’t join “%1$s”</string>

    <!-- Desktop's missing Surface page: a Surface this computer doesn't know. -->
    <string name="surface_missing">This isn’t here. It may belong to a Happy Agent this one can’t reach.</string>
