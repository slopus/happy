<?xml version="1.0" encoding="utf-8"?>
<!--
  Managed configurations an organization's EMM can set (config/ManagedSettings.kt).
  The keys are the edge SSO contract's, identical on iOS and desktop. A key the EMM
  leaves unset is the person's own choice; a set one is enforced and shown locked.
  analyticsEnabled can only turn analytics off: true means the same as unset.
  No defaults on purpose: RestrictionsManager reports only what the EMM set.
-->
<restrictions xmlns:android="http://schemas.android.com/apk/res/android">
    <restriction
        android:key="serverUrl"
        android:restrictionType="string"
        android:title="@string/managed_server_url"
        android:description="@string/managed_server_url_description" />
    <restriction
        android:key="allowAdditionalServers"
        android:restrictionType="bool"
        android:title="@string/managed_allow_additional_servers" />
    <restriction
        android:key="analyticsEnabled"
        android:restrictionType="bool"
        android:title="@string/managed_analytics_enabled"
        android:description="@string/managed_analytics_enabled_description" />
    <restriction
        android:key="hostedRelayEnabled"
        android:restrictionType="bool"
        android:title="@string/managed_hosted_relay_enabled" />
    <restriction
        android:key="tailcatEnabled"
        android:restrictionType="bool"
        android:title="@string/managed_tailcat_enabled" />
    <restriction
        android:key="phonePairingEnabled"
        android:restrictionType="bool"
        android:title="@string/managed_phone_pairing_enabled" />
</restrictions>
