{
  "genuiRender": 1,
  "compiler": "harness",
  "fallback": "Secrets to add.",
  "root": "secrets",
  "elements": {
    "secrets": {
      "type": "box",
      "props": {
        "role": "plain",
        "direction": "column",
        "gap": "items"
      },
      "children": [
        "cluster-endpoint",
        "cluster-ssh",
        "cluster-git",
        "cluster-environment",
        "cluster-change"
      ]
    },
    "cluster-endpoint": {
      "type": "button",
      "props": {
        "label": "Add Stripe key",
        "variant": "secondary",
        "action": {
          "type": "cluster_secret",
          "secret": {
            "type": "endpoint",
            "name": "Stripe API",
            "description": "Stripe test-mode key",
            "uses": [
              "egress"
            ],
            "owner": "team",
            "public": {
              "targets": [
                {
                  "host": "api.stripe.com",
                  "pathPrefixes": [
                    "/v1/"
                  ]
                }
              ],
              "algorithm": {
                "kind": "headers",
                "headers": [
                  {
                    "name": "Authorization",
                    "prefix": "Bearer "
                  }
                ]
              }
            }
          }
        }
      }
    },
    "cluster-ssh": {
      "type": "button",
      "props": {
        "label": "Add deploy key",
        "variant": "secondary",
        "action": {
          "type": "cluster_secret",
          "secret": {
            "type": "ssh_key",
            "name": "Deploy key",
            "uses": [
              "ssh"
            ],
            "public": {
              "hosts": [
                "deploy.example.com"
              ],
              "ports": [
                22
              ]
            }
          }
        }
      }
    },
    "cluster-git": {
      "type": "button",
      "props": {
        "label": "Add GitHub token",
        "variant": "secondary",
        "action": {
          "type": "cluster_secret",
          "secret": {
            "type": "git_credential",
            "name": "GitHub",
            "description": "Pushes to slopus/happy",
            "uses": [
              "git"
            ],
            "public": {
              "server": "github.com",
              "method": {
                "kind": "token"
              },
              "repos": [
                "slopus/happy"
              ],
              "operations": [
                "read",
                "write"
              ]
            }
          }
        }
      }
    },
    "cluster-environment": {
      "type": "button",
      "props": {
        "label": "Add OpenAI keys",
        "variant": "secondary",
        "action": {
          "type": "cluster_secret",
          "secret": {
            "type": "environment",
            "name": "OpenAI",
            "uses": [
              "environment"
            ],
            "public": {
              "variables": [
                "OPENAI_API_KEY",
                "OPENAI_ORG"
              ]
            }
          }
        }
      }
    },
    "cluster-change": {
      "type": "button",
      "props": {
        "label": "Rotate Stripe key",
        "variant": "secondary",
        "action": {
          "type": "cluster_secret",
          "secret": {
            "type": "endpoint",
            "id": "stripesecret000000000001",
            "name": "Stripe API"
          }
        }
      }
    }
  }
}
