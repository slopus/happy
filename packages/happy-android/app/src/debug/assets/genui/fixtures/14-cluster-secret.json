{
  "genuiRender": 1,
  "compiler": "1.0.0",
  "fallback": "Add a Stripe API key so agents can call api.stripe.com through the egress proxy.",
  "root": "card",
  "elements": {
    "card": {
      "type": "box",
      "props": {
        "role": "card",
        "gap": "blocks"
      },
      "children": [
        "card.header",
        "text",
        "card.actions"
      ]
    },
    "card.header": {
      "type": "box",
      "props": {
        "role": "header",
        "direction": "row",
        "gap": "inline",
        "align": "start",
        "justify": "between"
      },
      "children": [
        "card.icon",
        "card.heading"
      ]
    },
    "card.icon": {
      "type": "icon",
      "props": {
        "name": "lock",
        "role": "leading"
      }
    },
    "card.heading": {
      "type": "box",
      "props": {
        "gap": "tight",
        "grow": true
      },
      "children": [
        "card.title"
      ]
    },
    "card.title": {
      "type": "text",
      "props": {
        "spans": [
          {
            "text": "Stripe API key"
          }
        ],
        "role": "title"
      }
    },
    "text": {
      "type": "text",
      "props": {
        "spans": [
          {
            "text": "Billing agents call "
          },
          {
            "text": "api.stripe.com",
            "code": true
          },
          {
            "text": ". Add a restricted key and the proxy sends it for them; no agent sees the key."
          }
        ],
        "role": "body"
      }
    },
    "card.actions": {
      "type": "box",
      "props": {
        "role": "actions",
        "direction": "row",
        "gap": "inline",
        "wrap": true
      },
      "children": [
        "add-stripe"
      ]
    },
    "add-stripe": {
      "type": "button",
      "props": {
        "label": "Add Stripe key",
        "action": {
          "type": "cluster_secret",
          "secret": {
            "type": "endpoint",
            "name": "Stripe API",
            "description": "Restricted key for billing agents",
            "public": {
              "targets": [
                {
                  "host": "api.stripe.com",
                  "pathPrefixes": [
                    "/v1"
                  ],
                  "methods": [
                    "GET",
                    "POST"
                  ]
                }
              ],
              "algorithm": {
                "kind": "headers",
                "headers": [
                  {
                    "name": "Authorization",
                    "prefix": "Bearer "
                  }
                ]
              }
            },
            "owner": "team",
            "uses": [
              "egress"
            ]
          }
        },
        "icon": "lock",
        "variant": "primary"
      }
    }
  }
}
