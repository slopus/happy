{
  "genuiRender": 1,
  "compiler": "1.0.0",
  "fallback": "I need your Stripe test-mode keys to run the billing tests: STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET.",
  "root": "card",
  "elements": {
    "card": {
      "type": "box",
      "props": {
        "role": "card",
        "gap": "blocks"
      },
      "children": [
        "card.header",
        "text",
        "keyvalue",
        "card.actions"
      ]
    },
    "card.header": {
      "type": "box",
      "props": {
        "role": "header",
        "direction": "row",
        "gap": "inline",
        "align": "start",
        "justify": "between"
      },
      "children": [
        "card.icon",
        "card.heading"
      ]
    },
    "card.icon": {
      "type": "icon",
      "props": {
        "name": "lock",
        "role": "leading"
      }
    },
    "card.heading": {
      "type": "box",
      "props": {
        "gap": "tight",
        "grow": true
      },
      "children": [
        "card.title"
      ]
    },
    "card.title": {
      "type": "text",
      "props": {
        "spans": [
          {
            "text": "Stripe test keys"
          }
        ],
        "role": "title"
      }
    },
    "text": {
      "type": "text",
      "props": {
        "spans": [
          {
            "text": "I need your Stripe "
          },
          {
            "text": "test-mode",
            "strong": true
          },
          {
            "text": " keys to run the billing tests. Find them in the Stripe dashboard under "
          },
          {
            "text": "Developers → API keys",
            "emphasis": true
          },
          {
            "text": "."
          }
        ],
        "role": "body"
      }
    },
    "keyvalue": {
      "type": "switch",
      "props": {},
      "slots": {
        "compact": [
          "keyvalue.compact"
        ],
        "regular": [
          "keyvalue.regular"
        ]
      }
    },
    "keyvalue.compact": {
      "type": "box",
      "props": {
        "gap": "items",
        "divide": "full",
        "leading": "none"
      },
      "children": [
        "keyvalue.compact.0",
        "keyvalue.compact.1"
      ]
    },
    "keyvalue.compact.0": {
      "type": "box",
      "props": {
        "role": "item",
        "direction": "row",
        "gap": "inline",
        "align": "baseline",
        "leading": "none"
      },
      "children": [
        "keyvalue.compact.0.texts",
        "keyvalue.compact.0.value"
      ]
    },
    "keyvalue.compact.0.texts": {
      "type": "box",
      "props": {
        "grow": true
      },
      "children": [
        "keyvalue.compact.0.label"
      ]
    },
    "keyvalue.compact.0.label": {
      "type": "text",
      "props": {
        "spans": [
          {
            "text": "STRIPE_SECRET_KEY"
          }
        ],
        "role": "label"
      }
    },
    "keyvalue.compact.0.value": {
      "type": "text",
      "props": {
        "spans": [
          {
            "text": "Secret key, starts with sk_test_"
          }
        ],
        "role": "body",
        "align": "end",
        "fixed": true
      }
    },
    "keyvalue.compact.1": {
      "type": "box",
      "props": {
        "role": "item",
        "direction": "row",
        "gap": "inline",
        "align": "baseline",
        "leading": "none"
      },
      "children": [
        "keyvalue.compact.1.texts",
        "keyvalue.compact.1.value"
      ]
    },
    "keyvalue.compact.1.texts": {
      "type": "box",
      "props": {
        "grow": true
      },
      "children": [
        "keyvalue.compact.1.label"
      ]
    },
    "keyvalue.compact.1.label": {
      "type": "text",
      "props": {
        "spans": [
          {
            "text": "STRIPE_WEBHOOK_SECRET"
          }
        ],
        "role": "label"
      }
    },
    "keyvalue.compact.1.value": {
      "type": "text",
      "props": {
        "spans": [
          {
            "text": "Signing secret of the webhook endpoint"
          }
        ],
        "role": "body",
        "align": "end",
        "fixed": true
      }
    },
    "keyvalue.regular": {
      "type": "grid",
      "props": {
        "columns": [
          {
            "width": "auto"
          },
          {
            "width": "fill"
          }
        ],
        "density": "pairs"
      },
      "children": [
        "keyvalue.regular.0.label",
        "keyvalue.regular.0.value",
        "keyvalue.regular.1.label",
        "keyvalue.regular.1.value"
      ]
    },
    "keyvalue.regular.0.label": {
      "type": "text",
      "props": {
        "spans": [
          {
            "text": "STRIPE_SECRET_KEY"
          }
        ],
        "role": "label"
      }
    },
    "keyvalue.regular.0.value": {
      "type": "text",
      "props": {
        "spans": [
          {
            "text": "Secret key, starts with sk_test_"
          }
        ],
        "role": "body",
        "fixed": true
      }
    },
    "keyvalue.regular.1.label": {
      "type": "text",
      "props": {
        "spans": [
          {
            "text": "STRIPE_WEBHOOK_SECRET"
          }
        ],
        "role": "label"
      }
    },
    "keyvalue.regular.1.value": {
      "type": "text",
      "props": {
        "spans": [
          {
            "text": "Signing secret of the webhook endpoint"
          }
        ],
        "role": "body",
        "fixed": true
      }
    },
    "card.actions": {
      "type": "box",
      "props": {
        "role": "actions",
        "direction": "row",
        "gap": "inline",
        "wrap": true
      },
      "children": [
        "add-stripe"
      ]
    },
    "add-stripe": {
      "type": "button",
      "props": {
        "label": "Add Stripe keys",
        "action": {
          "type": "secret",
          "secret": {
            "id": "stripe",
            "description": "Stripe test-mode keys for the billing service",
            "variables": [
              {
                "name": "STRIPE_SECRET_KEY",
                "description": "Secret key, starts with sk_test_"
              },
              {
                "name": "STRIPE_WEBHOOK_SECRET",
                "description": "Signing secret of the webhook endpoint"
              }
            ]
          }
        },
        "icon": "lock",
        "variant": "primary"
      }
    }
  }
}
