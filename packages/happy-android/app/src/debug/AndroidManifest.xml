<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- The bundled Gen UI render documents, listed and drawn (ui/genui/GenUiFixturesActivity); its own launcher icon. -->
        <activity
            android:name=".ui.genui.GenUiFixturesActivity"
            android:exported="true"
            android:label="Gen UI fixtures"
            android:taskAffinity="com.slopus.happy.genui.fixtures">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- A Happy Agent chat's Group tool calls over an in-memory computer (ui/conversation/ToolSectionsFixturesActivity). -->
        <activity
            android:name=".ui.conversation.ToolSectionsFixturesActivity"
            android:exported="true" />
        <!-- The Pipelines page over an in-memory Happy Cloud server (ui/pipelines/PipelinesFixturesActivity). -->
        <activity
            android:name=".ui.pipelines.PipelinesFixturesActivity"
            android:exported="true" />
        <!-- The header's viewers over an in-memory computer (ui/viewers/ViewersFixturesActivity). -->
        <activity
            android:name=".ui.viewers.ViewersFixturesActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />
        <!-- The plugin pages over an in-memory Happy Cloud server (ui/plugins/PluginsFixturesActivity). -->
        <activity
            android:name=".ui.plugins.PluginsFixturesActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />
        <!-- The AI providers list, add chooser, API key and own-endpoint pages over an in-memory server (ui/connection/CloudProvidersFixturesActivity). -->
        <activity
            android:name=".ui.connection.CloudProvidersFixturesActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />
        <!-- Settings › Inference (a Happy Agent's accounts) and its sign-in and token pages over the contract in memory (ui/connection/ProviderAccountsFixturesActivity). -->
        <activity
            android:name=".ui.connection.ProviderAccountsFixturesActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />
        <!-- Settings › Compute over a live plain-HTTP test API, token in the intent (ui/connection/ComputeLiveActivity). -->
        <activity
            android:name=".ui.connection.ComputeLiveActivity"
            android:exported="true" />
        <!-- A policy document's page over an in-memory server (ui/connection/PolicyDocumentFixturesActivity). -->
        <activity
            android:name=".ui.connection.PolicyDocumentFixturesActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />
        <!-- Happy Cloud's shared and personal bots: homes, a bot's page and its settings over an in-memory server (ui/bots/BotsFixturesActivity). -->
        <activity
            android:name=".ui.bots.BotsFixturesActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />
        <!-- A Happy Cloud server's onboarding flow over an in-memory server (ui/gates/CloudOnboardingFixturesActivity). -->
        <activity
            android:name=".ui.gates.CloudOnboardingFixturesActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />
        <!-- One Gen UI render document alone on the chat's ground, for screenshots (ui/genui/GenUiGymActivity). -->
        <activity
            android:name=".ui.genui.GenUiGymActivity"
            android:exported="true" />
        <!-- A render fixture opened as a gen_ui artifact on the real artifact screen (ui/genui/GenUiArtifactGymActivity). -->
        <activity
            android:name=".ui.genui.GenUiArtifactGymActivity"
            android:exported="true" />
        <!-- 100 Gen UI artifacts under their cards in the chat's own rows, for scrolling and frame timing (ui/genui/GenUiChatGymActivity). -->
        <activity
            android:name=".ui.genui.GenUiChatGymActivity"
            android:exported="true" />
    </application>
</manifest>
