# Copy to keystore.properties (gitignored) to sign store builds locally.
# Paths are relative to packages/happy-android. Each key can instead come
# from the environment, which wins: HAPPY_RELEASE_KEYSTORE,
# HAPPY_RELEASE_KEYSTORE_PASSWORD, HAPPY_RELEASE_KEY_ALIAS,
# HAPPY_RELEASE_KEY_PASSWORD, and the same with HAPPY_PREVIEW_.
# Release and preview must use the EAS/Play upload keys the React Native app
# ships with, or the update will not install over it (AGENTS.md).
release.storeFile=
release.storePassword=
release.keyAlias=
release.keyPassword=
preview.storeFile=
preview.storePassword=
preview.keyAlias=
preview.keyPassword=
