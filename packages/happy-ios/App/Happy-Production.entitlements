<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:app.happy.engineering</string>
		<!-- applinks:join.happy.engineering (Happy Cloud's invite links) comes back when Happy Cloud
		     ships; until then the App Store app leaves them to the browser. Development and preview keep it. -->
		<string>applinks:link.happy.page</string>
	</array>
</dict>
</plist>
