<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDisplayName</key>
	<string>Happy</string>
	<key>CFBundleShortVersionString</key>
	<string>2.0.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>engineering.happy</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>happy</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>157</string>
	<key>HappyAppVariant</key>
	<string>production</string>
	<key>HappyCallAgentID</key>
	<string>$(HAPPY_CALL_AGENT_ID)</string>
	<key>HappyPostHogKey</key>
	<string>$(HAPPY_POSTHOG_API_KEY)</string>
	<key>HappyRevenueCatAppleKey</key>
	<string>$(HAPPY_REVENUE_CAT_APPLE_KEY)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Allow Happy to show your photos and videos so you can share them in chats.</string>
	<key>PHPhotoLibraryPreventAutomaticLimitedAccessAlert</key>
	<true/>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Allow Happy to save pictures and videos your agents made to your library.</string>
	<key>NSCameraUsageDescription</key>
	<string>Allow Happy to access your camera to scan QR codes and share photos with AI.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Allow Happy to use your microphone to talk with your coding agents.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Allow Happy to find and connect to local devices on your network.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
