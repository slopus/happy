                {
                    "type": "route",
                    "path": "session/cmuckup1z0002ceqes4npn29g"
                },
                { "type": "wait", "selector": { "field": "text", "value": "Maya" } },
                { "type": "back" },
                {
                    "type": "route",
                    "path": "session/cmuaqym3i0015cetyfazs8194"
                },
                {
                    "type": "wait",
                    "selector": {
                        "field": "text",
                        "value": "Check how voice follows the session I’m looking at."
                    }
                },
                { "type": "wait", "selector": { "field": "text", "value": "online" } },
                { "type": "settle" }
            ]
        },
        {
            "id": "models",
            "steps": [
                { "type": "point", "point": "695,995" },
                { "type": "wait", "selector": { "field": "text", "value": "Auto" } },
