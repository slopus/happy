        {
            "id": "multiplayer",
            "steps": [
                {
                    "type": "tap",
                    "selector": { "field": "description", "value": "Zen mode" }
                },
                {
                    "type": "route",
                    "path": "session/cmuckup1z0002ceqes4npn29g"
                },
                { "type": "wait", "selector": { "field": "text", "value": "Maya" } },
                { "type": "wait", "selector": { "field": "text", "value": "Jamie" } },
