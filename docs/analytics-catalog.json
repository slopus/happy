    "app_opened": {
      "tier": "usage",
      "clients": [
        "desktop",
        "ios",
        "android"
      ],
      "fires": "Desktop: once per launch. Mobile: a cold start, or returning to the foreground after 30 minutes or more in the background. Carries only notifications permission, app language, and how many agents are connected.",
