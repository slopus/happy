  "definitions": {
    "launch_count": "Launches on this install: desktop renderer launches, mobile cold starts.",
    "agents_connected": "Happy Agent connections the client has (paired agents on a phone, configured agents on desktop).",
    "message_sent": "Fires when the person presses send, including when an offline-first client only queues it locally. Conversation creation also sends conversation_created; steering is message_sent with is_steering.",
    "model use": "Which model, provider kind and effort people use comes from message_sent, which carries all three on every send. There are no picker events."
  },
  "naming": {
    "events": "snake_case `<object>_<past-tense verb>`, as PostHog's capture docs recommend ('project created', 'user signed up', 'invite sent') and as the existing events already are (message_sent, bot_created, app_opened). One event per step in how a person uses Happy. Static names; variable parts go in properties. No category: prefix.",
    "verbs": [
      "opened",
      "created",
      "added",
      "sent",
      "answered",
      "stopped",
      "changed",
      "switched",
      "completed",
      "failed",
      "cancelled",
      "shown",
      "selected",
      "clicked",
      "copied",
      "crashed",
      "lost",
      "started",
      "presented",
      "purchased",
      "restored",
      "signed_in",
      "viewed"
    ],
    "properties": "snake_case `<object>_<adjective>`; new booleans start with is_ or has_. Existing property names are never renamed.",
    "continuity": "Event and property names already in PostHog (desktop since 2026-10-08, the earlier Expo app before that) are kept. Only privacy fixes change existing events."
  },
  "principle": "Err on the side of fewer events and more privacy. An event earns its place only if it answers a question no existing event answers. Anything derivable from message_sent is not its own event.",
  "packaging": {
    "rule": "Analytics lives in its own package or module on every platform, with one small facade the app calls. Deleting the module plus its one-line call sites removes analytics entirely. A build without a PostHog key compiles the module but sends nothing.",
    "desktop": "packages/happy-desktop-analytics (exists)",
    "ios": "a separate SwiftPM target HappyAnalytics, depended on by HappyApp and HappyUI only for the facade",
    "android": "a separate Gradle module :analytics",
    "settings": "Every client has an Analytics switch in Settings that stops sending and deletes the queue. Mobile also honours each account's synced analyticsOptOut."
  }
}
