{
  "version": 5,
  "about": "Happy product analytics catalog shared by Happy Desktop, happy-ios and happy-android. Every event and property a client may send. Values are closed enums, counts, booleans, versions, or the model rule; nothing else may leave a client. Clients send only the events listed for them. Optional properties may be omitted; nullable properties may be null.",
  "types": {
    "count": "integer 0..1000000",
    "version": "string matching ^[0-9]+(\\.[0-9]+){0,3}$, at most 32 characters. Clients strip any prerelease or build suffix (everything from the first '-' or '+') before sending; a value that still does not match is sent as null.",
    "os_version": "string matching ^[0-9]+(\\.[0-9]+)?$ (major.minor only)"
  },
  "shared_enums": {
    "provider_kind": [
      "claude",
      "codex",
      "grok",
      "bedrock",
      "anthropic",
      "gemini",
      "glm",
      "kimi",
      "openai",
      "other"
    ],
    "failure_kind": [
      "signin_missing",
      "usage_limit",
      "no_account_available",
      "rate_limited",
      "provider_unavailable",
      "network",
      "context_too_long",
      "provider_disabled",
      "internal",
      "other",
      "untyped"
    ],
    "duration": [
      "under_10s",
      "10s_to_30s",
      "30s_to_2m",
      "2m_to_5m",
      "5m_to_15m",
      "15m_to_1h",
      "over_1h"
    ],
    "error_code": [
      "offline",
      "timeout",
      "unauthorized",
      "forbidden",
      "not_found",
      "conflict",
      "too_large",
      "rate_limited",
      "server_error",
      "refused",
      "version_mismatch",
      "invalid_response",
      "unsupported",
      "unknown"
    ],
    "pairing_method": [
      "relay",
      "direct"
    ],
    "pairing_surface": [
      "onboarding",
      "mobile_access",
      "settings",
      "connect_agent"
    ],
    "result": [
      "ok",
      "failed",
      "cancelled"
    ],
    "effort": [
      "off",
      "on",
      "minimal",
      "low",
      "medium",
      "high",
      "xhigh",
      "max",
      "ultra"
    ],
    "bucket_123": [
      "0",
      "1",
      "2",
      "3+"
    ],
    "permission_mode": [
      "auto",
      "workspace_write",
      "read_only",
      "full_access"
    ],
    "create_error_code": [
      "refused",
      "offline",
      "unknown"
    ],
    "model_family": [
      "claude_opus",
      "claude_sonnet",
      "claude_haiku",
      "claude_fable",
      "gpt",
      "grok",
      "gemini",
      "glm",
      "kimi",
      "other"
    ]
  },
  "common": {
    "client": {
      "enum": [
        "desktop",
        "ios",
        "android"
      ]
    },
    "app_version": {
      "type": "version"
    },
    "os": {
      "enum": [
        "mac",
        "win",
        "linux",
        "ios",
        "android"
      ]
    },
    "os_version": {
      "type": "os_version",
      "nullable": true
    },
    "device_class": {
      "enum": [
        "desktop",
        "phone",
        "tablet"
      ]
    },
    "arch": {
      "enum": [
        "arm64",
        "x64",
        "other"
      ],
      "nullable": true,
      "clients": [
        "desktop"
      ]
    },
    "agent_location": {
      "enum": [
        "local",
        "remote",
        "relay"
      ],
      "nullable": true
    },
    "agent_os": {
      "enum": [
        "mac",
        "win",
        "linux",
        "other"
      ],
      "nullable": true
    },
    "happy_agent_version": {
      "type": "version",
      "nullable": true
    },
    "flavor": {
      "enum": [
        "standard",
        "nightly",
        "preview",
        "development"
      ]
    }
  },
  "events": {
    "chat_failure_shown": {
      "tier": "error",
      "clients": [
        "desktop",
        "ios",
        "android"
      ],
      "fires": "A failed agent turn's card is first rendered in the visible, focused conversation and the failure message is at most 5 minutes old. Deduplicated per device by message id in a bounded local set (500); the id is never sent. untyped means a Happy Agent service-message error without a typed failure (an older daemon). Happy CLI session errors are not detectable without matching text and are not sent.",
      "properties": {
        "kind": {
          "enum": "failure_kind"
        },
        "provider_kind": {
          "enum": "provider_kind",
          "nullable": true
        },
        "target": {
          "enum": [
            "chief_of_staff",
            "bot",
            "session"
          ]
        },
        "session_client": {
          "enum": [
            "happy_agent",
            "cli"
          ]
        },
        "is_pool": {
          "type": "bool"
        }
      }
    },
    "chat_failure_action_clicked": {
      "tier": "error",
      "clients": [
        "desktop",
        "ios",
        "android"
      ],
      "fires": "The person taps an action on a failure card, on the device where they tapped.",
      "properties": {
        "kind": {
          "enum": "failure_kind"
        },
        "action": {
          "enum": [
            "retry",
            "switch_model",
            "new_chat",
            "ask_chief",
            "sign_in",
            "copy_command",
            "open_settings"
          ]
        }
      }
    },
    "agent_connection_lost": {
      "tier": "error",
      "clients": [
        "desktop",
        "ios",
        "android"
      ],
      "fires": "Once per outage, when it ends, only if the connection to the agent (or relay) was down for 10 seconds or more while the app was in the foreground. Reconnects under 10 s send nothing.",
      "properties": {
        "transport": {
          "enum": [
            "local",
            "remote",
            "direct",
            "relay"
          ]
        },
        "code": {
          "enum": [
            "unreachable",
            "timeout",
            "auth_expired",
            "revoked",
            "version_mismatch",
            "edge_blocked",
            "server_error",
            "unknown"
          ]
        },
        "outcome": {
          "enum": [
            "recovered",
            "restarted",
            "gave_up",
            "backgrounded",
            "closed"
          ]
        },
        "duration": {
          "enum": "duration"
        },
        "is_recovery_screen_shown": {
          "type": "bool"
        }
      }
    },
    "error_shown": {
      "tier": "error",
      "clients": [
        "desktop",
        "ios",
        "android"
      ],
      "fires": "Any other error state a person saw. At most one per (area, code) per 10 minutes per device; repeats inside that window are dropped, not counted. Failed creates are not error_shown: they are the *_created / project_added events with result failed.",
      "properties": {
        "area": {
          "enum": [
            "conversation_load",
            "message_send",
            "attachment_upload",
            "file_load",
            "diff_load",
            "artifact_load",
            "browser_load",
            "terminal",
            "voice",
            "model_list",
            "settings_save",
            "push_setup",
            "update",
            "ui_render"
          ]
        },
        "code": {
          "enum": "error_code"
        }
      }
    },
    "app_crashed": {
      "tier": "error",
      "clients": [
        "desktop",
        "ios",
        "android"
      ],
      "fires": "A process of the app died abnormally. Mobile: read at the next launch from the OS's own exit records (MetricKit, ApplicationExitInfo); only the exception type or signal (mapped to reason) and the app version are read, never the stack, symbols, termination text or memory regions. Desktop: a renderer or child process that dies is reported by the main process to the reloaded window in memory; a main-process crash is not reported. Nothing is written to disk.",
      "properties": {
        "process": {
          "enum": [
            "main",
            "renderer",
            "app",
            "extension"
          ]
        },
        "reason": {
          "enum": [
            "crash",
            "native_crash",
            "oom",
            "hang",
            "killed",
            "launch_failed",
            "integrity",
            "unknown"
          ]
        },
        "crashed_version": {
          "type": "version",
          "nullable": true
        }
      }
    },
