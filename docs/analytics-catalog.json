{
  "version": 4,
  "about": "Happy product analytics catalog shared by Happy Desktop, happy-ios and happy-android. Every event and property a client may send. Values are closed enums, counts, booleans, versions, or the model rule; nothing else may leave a client. Clients send only the events listed for them. Optional properties may be omitted; nullable properties may be null.",
  "types": {
    "count": "integer 0..1000000",
    "version": "string matching ^[0-9]+(\\.[0-9]+){0,3}([-+][0-9A-Za-z.]+)?$, at most 64 characters",
    "os_version": "string matching ^[0-9]+(\\.[0-9]+)?$ (major.minor only)",
    "model": "string matching ^(anthropic|openai|xai|google|zai|moonshotai)/[a-z0-9][a-z0-9.-]{0,63}$, or \"other\"; any providerId: prefix is stripped first"
  },
  "shared_enums": {
    "provider_kind": [
      "claude",
      "codex",
      "grok",
      "bedrock",
      "anthropic",
      "gemini",
      "glm",
      "kimi",
      "openai",
      "other"
    ],
    "failure_kind": [
      "signin_missing",
      "usage_limit",
      "no_account_available",
      "rate_limited",
      "provider_unavailable",
      "network",
      "context_too_long",
      "provider_disabled",
      "internal",
      "other",
      "untyped"
    ],
    "duration": [
      "under_10s",
      "10s_to_30s",
      "30s_to_2m",
      "2m_to_5m",
      "5m_to_15m",
      "15m_to_1h",
      "over_1h"
    ],
    "error_code": [
      "offline",
      "timeout",
      "unauthorized",
      "forbidden",
      "not_found",
      "conflict",
      "too_large",
      "rate_limited",
      "server_error",
      "refused",
      "version_mismatch",
      "invalid_response",
      "unsupported",
      "unknown"
    ],
    "pairing_method": [
      "relay",
      "direct"
    ],
    "pairing_surface": [
      "onboarding",
      "mobile_access",
      "settings",
      "connect_agent"
    ],
    "result": [
      "ok",
      "failed",
      "cancelled"
    ],
    "effort": [
      "off",
      "on",
      "minimal",
      "low",
      "medium",
      "high",
      "xhigh",
      "max",
      "ultra"
    ],
    "bucket_123": [
      "0",
      "1",
      "2",
      "3+"
    ],
    "permission_mode": [
      "auto",
      "workspace_write",
      "read_only",
      "full_access"
    ],
    "create_error_code": [
      "refused",
      "offline",
      "unknown"
    ]
  },
  "common": {
    "client": {
      "enum": [
        "desktop",
        "ios",
        "android"
      ]
    },
    "app_version": {
      "type": "version"
    },
    "os": {
      "enum": [
        "mac",
        "win",
        "linux",
        "ios",
        "android"
      ]
    },
    "os_version": {
      "type": "os_version",
      "nullable": true
    },
    "device_class": {
      "enum": [
        "desktop",
        "phone",
        "tablet"
      ]
    },
    "arch": {
      "enum": [
        "arm64",
        "x64",
        "other"
      ],
      "nullable": true,
      "clients": [
        "desktop"
      ]
    },
    "agent_location": {
      "enum": [
        "local",
        "remote",
        "relay"
      ],
      "nullable": true
    },
    "agent_os": {
      "enum": [
        "mac",
        "win",
        "linux",
        "other"
      ],
      "nullable": true
    },
    "happy_agent_version": {
      "type": "version",
      "nullable": true
    },
    "flavor": {
      "enum": [
        "standard",
        "nightly",
        "preview",
        "development"
      ]
    }
  },
  "events": {
    "chat_failure_shown": {
      "tier": "error",
      "clients": [
        "desktop",
        "ios",
        "android"
      ],
      "fires": "A failed agent turn's card is first rendered in the visible, focused conversation and the failure message is at most 5 minutes old. Deduplicated per device by message id in a bounded local set (500); the id is never sent. untyped means a Happy Agent service-message error without a typed failure (an older daemon). Happy CLI session errors are not detectable without matching text and are not sent.",
      "properties": {
        "kind": {
          "enum": "failure_kind"
        },
        "provider_kind": {
          "enum": "provider_kind",
          "nullable": true
        },
        "target": {
          "enum": [
            "chief_of_staff",
            "bot",
            "session"
          ]
        },
        "session_client": {
          "enum": [
            "happy_agent",
            "cli"
          ]
        },
        "is_pool": {
          "type": "bool"
        }
      }
    },
    "chat_failure_action_clicked": {
      "tier": "error",
      "clients": [
        "desktop",
        "ios",
        "android"
      ],
      "fires": "The person taps an action on a failure card, on the device where they tapped.",
      "properties": {
        "kind": {
          "enum": "failure_kind"
        },
        "action": {
          "enum": [
            "retry",
            "switch_model",
            "new_chat",
            "ask_chief",
            "sign_in",
            "copy_command",
            "open_settings"
          ]
        }
      }
    },
    "agent_connection_lost": {
      "tier": "error",
      "clients": [
        "desktop",
        "ios",
        "android"
      ],
      "fires": "Once per outage, when it ends, only if the connection to the agent (or relay) was down for 10 seconds or more while the app was in the foreground. Reconnects under 10 s send nothing.",
      "properties": {
        "transport": {
          "enum": [
            "local",
            "remote",
            "direct",
            "relay"
          ]
        },
        "code": {
          "enum": [
            "unreachable",
            "timeout",
            "auth_expired",
            "revoked",
            "version_mismatch",
            "edge_blocked",
            "server_error",
            "unknown"
          ]
        },
        "outcome": {
          "enum": [
            "recovered",
            "restarted",
            "gave_up",
            "backgrounded",
            "closed"
          ]
        },
        "duration": {
          "enum": "duration"
        },
        "is_recovery_screen_shown": {
          "type": "bool"
        }
      }
    },
    "error_shown": {
      "tier": "error",
      "clients": [
        "desktop",
        "ios",
        "android"
      ],
      "fires": "Any other error state a person saw. At most one per (area, code) per 10 minutes per device; suppressed occurrences are added to repeat_count of the next one sent. Failed creates are not error_shown: they are the *_created / project_added events with result failed.",
      "properties": {
        "area": {
          "enum": [
            "conversation_load",
            "message_send",
            "attachment_upload",
            "file_load",
            "diff_load",
            "artifact_load",
            "browser_load",
            "terminal",
            "voice",
            "model_list",
            "settings_save",
            "push_setup",
            "update",
            "ui_render"
          ]
        },
        "code": {
          "enum": "error_code"
        },
        "repeat_count": {
          "type": "count"
        }
      }
    },
    "app_crashed": {
      "tier": "error",
      "clients": [
        "desktop",
        "ios",
        "android"
      ],
      "fires": "A process of the app died abnormally. Reported at the next launch from OS exit records (MetricKit, ApplicationExitInfo) or a marker the desktop main process wrote. No stack, message, or symbol is ever sent.",
      "properties": {
        "process": {
          "enum": [
            "main",
            "renderer",
            "app",
            "extension"
          ]
        },
        "reason": {
          "enum": [
            "crash",
            "native_crash",
            "oom",
            "hang",
            "killed",
            "launch_failed",
            "integrity",
            "unknown"
          ]
        },
        "crashed_version": {
          "type": "version",
          "nullable": true
        }
      }
    },
    "onboarding_setup_result": {
      "tier": "error",
      "clients": [
        "desktop"
      ],
      "fires": "Unchanged from the existing desktop catalog.",
      "properties": {
        "result": {
          "enum": [
            "ok",
            "failed"
          ]
        },
        "error_code": {
          "enum": [
            "node_missing",
            "download_failed",
            "start_failed",
            "start_timeout",
            "version_mismatch",
            "connect_failed",
            "state_unreadable",
            "closed_during_setup"
          ],
          "optional": true
        },
        "error_detail": {
          "enum": [
            "release_lookup_rate_limited",
            "release_lookup_failed",
            "release_unavailable",
            "network_unreachable",
            "transfer_interrupted",
            "transfer_timeout",
            "transfer_http_error",
            "integrity_mismatch",
            "disk_full",
            "filesystem_locked",
            "extract_failed",
            "install_lock_timeout",
            "unclassified"
          ],
          "optional": true
        },
        "attempt_count": {
          "type": "count",
          "optional": true
        },
        "transfer_percent_bucket": {
          "enum": [
            "none",
            "under_half",
            "over_half",
            "complete"
          ],
          "optional": true
        },
        "duration_ms": {
          "type": "count"
        }
      }
    },
    "mobile_pairing_completed": {
      "tier": "error",
      "clients": [
        "desktop",
        "ios",
