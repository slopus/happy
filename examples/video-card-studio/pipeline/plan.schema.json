{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["cards"],
  "properties": {
    "cards": {
      "type": "array",
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "visual", "blocks"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 100},
          "visual": {"$ref": "#/$defs/visual"},
          "blocks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["evidence", "visual", "excerpts"],
              "properties": {
                "evidence": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"type": "string", "pattern": "^s[0-9]{4,8}$"}},
                "visual": {"anyOf": [{"$ref": "#/$defs/visual"}, {"type": "null"}]},
                "excerpts": {
                  "type": "array",
                  "maxItems": 1000,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["segment_id", "text"],
                    "properties": {
                      "segment_id": {"type": "string", "pattern": "^s[0-9]{4,8}$"},
                      "text": {"type": "string", "minLength": 1, "maxLength": 20000}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "role", "reason", "evidence"],
      "properties": {
        "time": {"type": "number", "minimum": 0},
        "role": {"type": "string", "enum": ["speaker", "chart", "demonstration", "scene"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 600},
        "evidence": {"type": "array", "maxItems": 1000, "items": {"type": "string", "pattern": "^s[0-9]{4,8}$"}}
      }
    }
  }
}
